<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Life Dashboard</title>
  <style>
    * { box-sizing: border-box; }
    :root {
      --bg: #f2f2f4;
      --panel: rgba(255,255,255,.78);
      --panel-strong: rgba(255,255,255,.96);
      --text: #161617;
      --muted: #74747a;
      --line: rgba(20,20,30,.08);
      --shadow: 0 18px 50px rgba(30,30,40,.10);
      --shadow-soft: 0 8px 22px rgba(30,30,40,.07);
      --red: #c95656;
      --red-dark: #9f3f3f;
      --red-line: rgba(182,72,72,.14);
      --green: #43835b;
    }

    html {
  background: var(--bg);
  overflow-y: scroll;
  scrollbar-gutter: stable;
}

    body {
      margin: 0;
      min-height: 100vh;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text",
        "Helvetica Neue", Arial, sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(255,255,255,.95), transparent 34%),
        linear-gradient(180deg, #f7f7f8 0%, #ededf0 100%);
      transition: background .3s ease;
    }

    body.finance-active {
      background:
        radial-gradient(circle at top left, rgba(255,255,255,.95), transparent 34%),
        linear-gradient(180deg, #f7f7f8 0%, #ededf0 100%);
    }

    body.finance-active .topbar {
      background: rgba(255,255,255,.62);
      border-color: rgba(255,255,255,.9);
    }

    button, input { font: inherit; }

    .app-shell {
      width: min(1180px, calc(100% - 40px));
      margin: 0 auto;
      padding: 28px 0 60px;
    }

    .topbar {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 24px;
      padding: 12px 14px 12px 18px;
      background: rgba(255,255,255,.62);
      border: 1px solid rgba(255,255,255,.9);
      border-radius: 26px;
      box-shadow: var(--shadow-soft);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      position: sticky;
      top: 18px;
      z-index: 20;
    }

    .brand {
      justify-self: start;
      display: flex;
      align-items: center;
      gap: 10px;
      border: 0;
      background: transparent;
      padding: 0;
      color: inherit;
      font-weight: 700;
      letter-spacing: -.02em;
      cursor: pointer;
    }

    .brand-dot {
      width: 12px;
      height: 12px;
      border-radius: 999px;
      background: #1f1f21;
      box-shadow: 0 0 0 6px rgba(31,31,33,.06);
    }

    .compact-datetime {
      justify-self: center;
      min-width: 185px;
      text-align: center;
      color: #55555b;
      font-size: .95rem;
      font-weight: 650;
      opacity: 0;
      transform: translateY(-4px);
      pointer-events: none;
      transition: .2s ease;
    }

    .compact-datetime.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .tabs {
      justify-self: end;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px;
      border-radius: 20px;
      background: rgba(236,236,239,.9);
      border: 1px solid var(--line);
    }

    .tab {
      border: 0;
      background: transparent;
      color: #65656b;
      padding: 10px 16px;
      border-radius: 15px;
      cursor: pointer;
      transition: .18s ease;
    }

    .tab:hover { transform: translateY(-1px); color: #2a2a2d; }

    .tab.active {
      background: var(--panel-strong);
      color: #111;
      box-shadow: 0 5px 16px rgba(20,20,30,.08);
    }

    body.finance-active .tab.active {
      background: var(--panel-strong);
      color: #111;
      box-shadow: 0 5px 16px rgba(20,20,30,.08);
    }

    .more-wrap { position: relative; }
    .chevron { margin-left: 4px; color: #8c8c92; display: inline-block; transform: translateY(-1.5px); }

    .more-menu {
      position: absolute;
      top: calc(100% + 12px);
      right: 0;
      min-width: 170px;
      padding: 8px;
      border-radius: 18px;
      background: rgba(255,255,255,.94);
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
      backdrop-filter: blur(24px);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-6px) scale(.98);
      transition: .16s ease;
    }

    .more-menu.open {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0) scale(1);
    }

    .more-menu button {
      width: 100%;
      border: 0;
      background: transparent;
      text-align: left;
      padding: 11px 12px;
      border-radius: 12px;
      color: #303034;
      cursor: pointer;
    }

    .more-menu button:hover { background: #f0f0f2; }

    .hero { padding: 72px 10px 38px; }

    .eyebrow {
      margin: 0 0 8px;
      color: var(--muted);
      font-size: .86rem;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .hero h1 {
      margin: 0;
      font-size: clamp(4rem, 10vw, 8rem);
      line-height: .95;
      letter-spacing: -.075em;
      font-weight: 740;
    }

    .date-line { margin-top: 20px; color: #66666d; font-size: 1.05rem; }

    .week-card, .content-card {
      background: var(--panel);
      border: 1px solid rgba(255,255,255,.92);
      border-radius: 30px;
      box-shadow: var(--shadow);
      backdrop-filter: blur(20px);
    }

    .week-card { padding: 24px; }

    .week-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 18px;
    }

    .week-head h2, .content-card h2 { margin: 0; font-size: 1.55rem; }

    .icon-button, .soft-button {
      border: 0;
      background: #ececef;
      color: #2f2f33;
      padding: 9px 13px;
      border-radius: 14px;
      cursor: pointer;
    }

    .week-grid {
      display: grid;
      grid-template-columns: repeat(7, minmax(0,1fr));
      gap: 10px;
    }

    .day {
      min-height: 112px;
      padding: 16px 12px;
      border-radius: 20px;
      background: rgba(245,245,247,.78);
      border: 1px solid rgba(30,30,40,.05);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .day.today {
      background: #1d1d1f;
      color: white;
      box-shadow: 0 14px 30px rgba(20,20,24,.18);
    }

    .day-name { font-size: .84rem; font-weight: 700; color: #77777d; }
    .day.today .day-name, .day.today .day-month { color: rgba(255,255,255,.68); }
    .day-number { font-size: 2rem; font-weight: 720; letter-spacing: -.05em; }
    .day-month { color: #96969c; font-size: .78rem; }

    .content-card {
      margin-top: 34px;
      padding: 30px;
      min-height: 320px;
    }

    .content-card p:last-child { color: #6d6d73; line-height: 1.6; }

    .section-view { margin-top: 30px; }

    .finance-shell {
      border-radius: 34px;
      padding: 30px;
      background: rgba(255,255,255,.72);
      border: 1px solid rgba(255,255,255,.92);
      box-shadow: 0 20px 55px rgba(30,30,40,.08);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }

    .finance-heading {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 24px;
    }

    .finance-heading h1 {
      margin: 0 0 8px;
      font-size: clamp(2rem, 4vw, 3.2rem);
      letter-spacing: -.055em;
    }

    .finance-heading p:last-child {
      margin: 0;
      color: #6d6d73;
    }

    .finance-eyebrow { color: var(--muted); }

    .soft-button {
      background: rgba(255,255,255,.78);
      border: 1px solid var(--line);
      color: #55555b;
    }

    .finance-summary {
      display: grid;
      grid-template-columns: 1.45fr 1fr 1fr;
      gap: 14px;
      margin-bottom: 18px;
    }

    .balance-card {
      min-height: 150px;
      border-radius: 25px;
      padding: 22px;
      background: rgba(255,255,255,.72);
      border: 1px solid var(--red-line);
      box-shadow: 0 12px 28px rgba(111,46,46,.06);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .balance-card > span:first-child,
    .card-label-row > span {
      color: #826b6b;
      font-size: .92rem;
      font-weight: 650;
    }

    .balance-card strong {
      font-size: 2rem;
      letter-spacing: -.045em;
    }

    .main-balance {
      background: linear-gradient(145deg, rgba(255,248,248,.96), rgba(247,220,220,.90));
      color: #352b2b;
      border: 1px solid rgba(182,72,72,.16);
      box-shadow: 0 12px 28px rgba(111,46,46,.06);
    }

    .main-balance .card-label-row > span,
    .main-balance .subtle { color: #8a6a6a; }

    .main-balance strong {
      font-size: 2.55rem;
      color: #443232;
    }

    .card-label-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .edit-balance {
      border: 1px solid rgba(182,72,72,.13);
      background: rgba(255,255,255,.72);
      color: #805757;
      border-radius: 12px;
      padding: 7px 10px;
      cursor: pointer;
    }

    .subtle { font-size: .82rem; }

    .positive-dot { color: var(--green); font-size: .82rem; }
    .negative-dot { color: var(--red); font-size: .82rem; }

    .finance-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0,1fr));
      gap: 14px;
    }

    .money-panel {
      background: rgba(255,255,255,.70);
      border: 1px solid var(--red-line);
      border-radius: 25px;
      padding: 20px;
      box-shadow: 0 10px 28px rgba(111,46,46,.045);
    }

    .income-panel {
      background: linear-gradient(145deg, rgba(251,255,252,.86), rgba(246,253,248,.78));
      border-color: rgba(66,131,91,.14);
    }

    .panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    .panel-head h2 {
      margin: 2px 0 0;
      font-size: 1.3rem;
      letter-spacing: -.035em;
    }

    .panel-kicker {
      color: #9a7a7a;
      font-size: .76rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .07em;
    }

    .add-button {
      width: 36px;
      height: 36px;
      border-radius: 12px;
      border: 1px solid var(--line);
      background: rgba(255,255,255,.82);
      color: #55555b;
      cursor: pointer;
      font-size: 1.15rem;
    }

    .quick-add {
      display: grid;
      grid-template-columns: 1fr 120px auto;
      gap: 8px;
      margin-bottom: 12px;
    }

    .quick-add input {
      min-width: 0;
      border: 1px solid rgba(130,80,80,.14);
      background: rgba(255,255,255,.9);
      border-radius: 12px;
      padding: 10px 11px;
      outline: none;
    }

    .quick-add button {
      border: 0;
      border-radius: 12px;
      background: #a94d4d;
      color: white;
      padding: 0 13px;
      cursor: pointer;
    }

    .money-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-height: 54px;
    }

    .empty-state {
      padding: 14px 2px;
      color: #a18b8b;
      font-size: .88rem;
    }

    .money-row {
      display: grid;
      grid-template-columns: 1fr auto auto auto;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      background: rgba(248,245,245,.72);
      border-radius: 14px;
    }

    .income-panel .money-row { background: rgba(244,249,245,.8); }

    .money-row .name { font-weight: 600; color: #443a3a; }
    .money-row .amount { font-weight: 700; font-variant-numeric: tabular-nums; }

    .edit-entry,
    .delete-entry {
      border: 0;
      cursor: pointer;
      border-radius: 10px;
      width: 30px;
      height: 30px;
      display: grid;
      place-items: center;
    }

    .edit-entry {
      background: rgba(255,255,255,.72);
      color: #8e6969;
      font-size: .86rem;
    }

    .delete-entry {
      background: transparent;
      color: #b28c8c;
      font-size: 1rem;
    }

    .edit-entry:hover {
      background: rgba(245,224,224,.82);
    }

    .panel-total {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid rgba(120,80,80,.10);
      color: #745e5e;
    }

    .panel-total strong { color: #3a3030; }


    .main-balance.positive-balance {
      background: linear-gradient(145deg, rgba(241,252,245,.98), rgba(218,242,226,.94));
      border-color: rgba(67,131,91,.18);
    }

    .main-balance.positive-balance .card-label-row > span,
    .main-balance.positive-balance .subtle {
      color: #5f7f69;
    }

    .main-balance.positive-balance strong {
      color: #2f6340;
    }

    .main-balance.negative-balance {
      background: linear-gradient(145deg, rgba(255,246,246,.98), rgba(246,217,217,.94));
      border-color: rgba(182,72,72,.18);
    }

    .main-balance.negative-balance .card-label-row > span,
    .main-balance.negative-balance .subtle {
      color: #946565;
    }

    .main-balance.negative-balance strong {
      color: #963f3f;
    }

    .balance-card.income-leading {
      background: linear-gradient(145deg, rgba(246,253,248,.96), rgba(230,246,235,.88));
      border-color: rgba(67,131,91,.18);
    }

    .balance-card.income-leading strong {
      color: #39734d;
    }

    .balance-card.expense-leading {
      background: linear-gradient(145deg, rgba(255,247,247,.96), rgba(248,225,225,.90));
      border-color: rgba(182,72,72,.18);
    }

    .balance-card.expense-leading strong {
      color: #a14444;
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: grid;
      place-items: center;
      padding: 24px;
      background: rgba(32, 24, 24, .24);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      opacity: 0;
      pointer-events: none;
      transition: opacity .18s ease;
    }

    .modal-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-card {
      width: min(430px, 100%);
      border-radius: 26px;
      padding: 24px;
      background: rgba(255, 252, 252, .96);
      border: 1px solid rgba(182,72,72,.12);
      box-shadow: 0 24px 70px rgba(55, 28, 28, .18);
      transform: translateY(10px) scale(.98);
      transition: transform .18s ease;
    }

    .modal-backdrop.open .modal-card {
      transform: translateY(0) scale(1);
    }

    .modal-card h3 {
      margin: 0 0 6px;
      font-size: 1.45rem;
      letter-spacing: -.035em;
    }

    .modal-card p {
      margin: 0 0 18px;
      color: #7a6868;
      line-height: 1.5;
      font-size: .94rem;
    }

    .modal-field {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 14px;
      border-radius: 16px;
      background: #fff;
      border: 1px solid rgba(145,84,84,.15);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.9);
    }

    .modal-field span {
      color: #8d7474;
      font-weight: 700;
    }

    .modal-field input {
      width: 100%;
      border: 0;
      outline: 0;
      background: transparent;
      font-size: 1.15rem;
      font-weight: 700;
      color: #3c3131;
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 18px;
    }

    .modal-actions button {
      border: 0;
      border-radius: 13px;
      padding: 10px 14px;
      cursor: pointer;
    }

    .modal-cancel {
      background: #efeded;
      color: #625858;
    }

    .modal-save {
      background: #a94d4d;
      color: white;
    }


    .gym-shell {
      border-radius: 34px;
      padding: 30px;
      background: rgba(255,255,255,.72);
      border: 1px solid rgba(255,255,255,.92);
      box-shadow: 0 20px 55px rgba(30,30,40,.08);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }

    .gym-heading {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 24px;
    }

    .gym-heading h1 {
      margin: 0 0 8px;
      font-size: clamp(2rem,4vw,3.2rem);
      letter-spacing: -.055em;
    }

    .gym-heading p:last-child {
      margin: 0;
      color: #6d6d73;
    }

    .gym-eyebrow { color: var(--muted); }

    .plan-picker {
      display: flex;
      align-items: center;
      gap: 9px;
      flex-wrap: wrap;
    }

    .plan-picker > span {
      color: #73737a;
      font-size: .82rem;
      font-weight: 700;
    }

    .plan-picker select {
      border: 1px solid var(--line);
      background: rgba(255,255,255,.92);
      border-radius: 14px;
      padding: 10px 34px 10px 12px;
      color: #28282c;
      outline: none;
    }

    .gym-secondary-button {
      border: 1px solid var(--line);
      background: rgba(255,255,255,.82);
      color: #55555b;
      padding: 9px 12px;
      border-radius: 13px;
      cursor: pointer;
    }

    .gym-secondary-button:hover {
      background: rgba(245,245,247,.95);
    }

    .gym-calendar-card {
      padding: 20px;
      border-radius: 26px;
      background: rgba(248,248,250,.82);
      border: 1px solid rgba(30,30,40,.06);
      margin-bottom: 16px;
    }

    .gym-calendar-head,
    .gym-panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .gym-calendar-head {
      margin-bottom: 16px;
    }

    .gym-calendar-head h2,
    .gym-panel-head h2 {
      margin: 2px 0 0;
      font-size: 1.35rem;
      letter-spacing: -.035em;
    }

    .gym-kicker {
      color: #8b8b92;
      font-size: .75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .07em;
    }

    .gym-days-viewport {
      overflow-x: auto;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
      padding: 4px 0 8px;
    }

    .gym-days-viewport::-webkit-scrollbar {
      display: none;
    }

    .gym-days-track {
      display: flex;
      gap: 10px;
      width: max-content;
    }

    .gym-day-card {
      flex: 0 0 160px;
      min-height: 124px;
      border: 1px solid rgba(30,30,40,.06);
      background: rgba(255,255,255,.88);
      border-radius: 20px;
      padding: 14px;
      scroll-snap-align: center;
      cursor: pointer;
      transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .gym-day-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 22px rgba(30,30,40,.06);
    }

    .gym-day-card.today {
      background: #1d1d1f;
      color: white;
      box-shadow: 0 12px 28px rgba(20,20,24,.14);
    }

    .gym-day-card.selected:not(.today) {
      box-shadow: inset 0 0 0 2px rgba(30,30,40,.16);
    }

    .gym-day-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 8px;
    }

    .gym-day-name {
      font-size: .82rem;
      font-weight: 700;
      color: #7a7a81;
      text-transform: uppercase;
    }

    .gym-day-card.today .gym-day-name {
      color: rgba(255,255,255,.64);
    }

    .gym-day-number {
      margin-top: 2px;
      font-size: 1.9rem;
      font-weight: 740;
      letter-spacing: -.05em;
    }

    .gym-session-name {
      margin-top: 16px;
      font-size: .92rem;
      font-weight: 700;
      color: #4b4b50;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .gym-day-card.today .gym-session-name {
      color: rgba(255,255,255,.92);
    }

    .gym-day-index {
      font-size: .72rem;
      color: #aaaab0;
    }

    .gym-day-card.today .gym-day-index {
      color: rgba(255,255,255,.52);
    }


    .gym-layout {
      display: grid;
      grid-template-columns: 1.35fr .85fr;
      gap: 14px;
    }

    .gym-panel {
      background: rgba(255,255,255,.78);
      border: 1px solid rgba(30,30,40,.06);
      border-radius: 25px;
      padding: 20px;
    }

    .gym-loop-summary {
      display: grid;
      grid-template-columns: repeat(2,minmax(0,1fr));
      gap: 10px;
      margin: 16px 0;
    }

    .gym-loop-summary > div {
      padding: 14px;
      border-radius: 16px;
      background: rgba(245,245,247,.82);
    }

    .gym-loop-summary span {
      display: block;
      color: #8a8a90;
      font-size: .76rem;
      margin-bottom: 4px;
    }

    .gym-loop-summary strong {
      font-size: 1rem;
      color: #343438;
    }

    .gym-loop-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .gym-loop-row {
      display: grid;
      grid-template-columns: auto 1fr auto auto;
      align-items: center;
      gap: 10px;
      padding: 10px 11px;
      border-radius: 15px;
      background: rgba(247,247,249,.9);
    }

    .gym-loop-number {
      width: 28px;
      height: 28px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      background: #ececef;
      color: #67676c;
      font-size: .78rem;
      font-weight: 700;
    }

    .gym-loop-row input {
      min-width: 0;
      border: 0;
      background: transparent;
      outline: none;
      font-weight: 650;
      color: #36363a;
    }

    .gym-loop-row button {
      border: 0;
      background: transparent;
      color: #8c8c92;
      cursor: pointer;
      width: 28px;
      height: 28px;
      border-radius: 9px;
    }

    .gym-loop-row button:hover {
      background: #ececef;
    }

    .gym-add-day-button {
      width: 100%;
      margin-top: 10px;
      border: 1px dashed rgba(30,30,40,.16);
      background: transparent;
      color: #66666b;
      padding: 11px 12px;
      border-radius: 14px;
      cursor: pointer;
    }

    .gym-selected-day {
      min-height: 230px;
      margin-top: 16px;
      border-radius: 20px;
      padding: 20px;
      background: linear-gradient(145deg, #f7f7f9, #efeff2);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
    }

    .gym-session-badge {
      display: inline-flex;
      align-items: center;
      min-height: 34px;
      padding: 0 12px;
      border-radius: 12px;
      background: #1d1d1f;
      color: white;
      font-weight: 700;
      margin-bottom: 12px;
    }

    .gym-selected-day p {
      margin: 0;
      color: #73737a;
      line-height: 1.55;
    }


