    }

    .meal-ingredient-preview {
      margin-top: 14px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      flex: 1;
    }

    .meal-ingredient-line {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      color: #6f6f75;
      font-size: .78rem;
    }

    .meal-ingredient-line strong {
      color: #55555b;
      font-weight: 700;
      white-space: nowrap;
    }

    .meal-empty {
      margin: auto 0;
      color: #aaaab0;
      font-size: .82rem;
    }

    .meal-macro-row {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 13px;
    }

    .meal-mini-macro {
      padding: 5px 7px;
      border-radius: 9px;
      font-size: .67rem;
      font-weight: 800;
    }

    .meal-mini-macro.protein { background: #eef4ff; color: #44658f; }
    .meal-mini-macro.carbs { background: #fff5e8; color: #9b6a2b; }
    .meal-mini-macro.fat { background: #f8eef8; color: #805b80; }

    .shopping-panel {
      border-radius: 26px;
      padding: 18px;
      position: sticky;
      top: 105px;
      max-height: calc(100vh - 130px);
      overflow: auto;
      scrollbar-width: thin;
    }

    .shopping-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 14px;
    }

    .shopping-head h2 {
      margin: 3px 0 0;
      font-size: 1.35rem;
      letter-spacing: -.035em;
    }

    .shopping-clear {
      width: 34px;
      height: 34px;
      border: 0;
      border-radius: 11px;
      background: #f0f0f2;
      color: #74747a;
      cursor: pointer;
    }

    .shopping-list {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .shopping-item {
      display: grid;
      grid-template-columns: 22px 1fr auto;
      gap: 9px;
      align-items: center;
      padding: 9px 10px;
      border-radius: 13px;
      background: #f7f7f8;
      cursor: pointer;
    }

    .shopping-item input {
      appearance: none;
      width: 17px;
      height: 17px;
      border-radius: 6px;
      border: 1.5px solid #b9b9bf;
      display: grid;
      place-items: center;
      cursor: pointer;
      margin: 0;
    }

    .shopping-item input:checked {
      background: #3e7450;
      border-color: #3e7450;
    }

    .shopping-item input:checked::after {
      content: "✓";
      color: white;
      font-size: .7rem;
      font-weight: 900;
    }

    .shopping-item.checked .shopping-name,
    .shopping-item.checked .shopping-amount {
      opacity: .42;
      text-decoration: line-through;
    }

    .shopping-name {
      min-width: 0;
      font-size: .82rem;
      font-weight: 650;
      color: #48484d;
    }

    .shopping-amount {
      font-size: .74rem;
      font-weight: 800;
      color: #74747a;
      white-space: nowrap;
    }

    .shopping-empty {
      min-height: 180px;
      display: grid;
      place-items: center;
      text-align: center;
      color: #aaaab0;
      font-size: .82rem;
      line-height: 1.5;
    }

    .nutrition-primary-button,
    .nutrition-secondary-button {
      border-radius: 13px;
      padding: 10px 13px;
      cursor: pointer;
      font-weight: 650;
    }

    .nutrition-primary-button {
      border: 0;
      background: #2f4f3a;
      color: white;
    }

    .nutrition-secondary-button {
      border: 1px solid rgba(30,30,40,.08);
      background: rgba(255,255,255,.86);
      color: #5e5e64;
    }

    .meal-editor-backdrop {
      position: fixed;
      inset: 0;
      z-index: 140;
      display: grid;
      place-items: center;
      padding: 24px;
      background: rgba(22,26,23,.30);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      opacity: 0;
      pointer-events: none;
      transition: opacity .18s ease;
    }

    .meal-editor-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }

    .meal-editor-card {
      width: min(720px,100%);
      max-height: min(840px,calc(100vh - 48px));
      overflow: auto;
      border-radius: 29px;
      padding: 24px;
      background: rgba(252,253,252,.985);
      border: 1px solid rgba(30,30,40,.08);
      box-shadow: 0 30px 90px rgba(20,25,21,.20);
      transform: translateY(10px) scale(.985);
      transition: transform .18s ease;
      scrollbar-width: thin;
    }

    .meal-editor-backdrop.open .meal-editor-card {
      transform: translateY(0) scale(1);
    }

    .meal-editor-header,
    .meal-editor-ingredients-head,
    .meal-editor-actions,
    .meal-editor-actions > div,
    .meal-prep-box,
    .meal-prep-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .meal-editor-header h2 {
      margin: 0;
      font-size: 1.6rem;
      letter-spacing: -.04em;
    }

    .meal-editor-close {
      width: 36px;
      height: 36px;
      border: 0;
      border-radius: 12px;
      background: #ededf0;
      color: #66666c;
      cursor: pointer;
      font-size: 1.15rem;
    }

    .meal-name-field {
      display: flex;
      flex-direction: column;
      gap: 7px;
      margin: 22px 0;
      color: #77777d;
      font-size: .8rem;
      font-weight: 700;
    }

    .meal-name-field input,
    .ingredient-field input,
    .ingredient-field select,
    .meal-prep-controls select {
      width: 100%;
      border: 1px solid rgba(30,30,40,.10);
      background: white;
      border-radius: 13px;
      padding: 10px 11px;
      color: #333338;
      outline: none;
    }

    .meal-editor-ingredients-head {
      margin-bottom: 10px;
    }

    .meal-editor-ingredients-head > div,
    .meal-prep-box > div:first-child {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .ingredient-editor-list {
      display: flex;
      flex-direction: column;
      gap: 9px;
    }

    .ingredient-editor-card {
      padding: 12px;
      border-radius: 17px;
      background: #f4f5f4;
    }

    .ingredient-main-fields {
      display: grid;
      grid-template-columns: minmax(0,1.6fr) 105px 92px 34px;
      gap: 8px;
      align-items: end;
    }

    .ingredient-macro-fields {
      display: grid;
      grid-template-columns: repeat(4,minmax(0,1fr));
      gap: 8px;
      margin-top: 8px;
    }

    .ingredient-field {
      display: flex;
      flex-direction: column;
      gap: 5px;
      min-width: 0;
    }

    .ingredient-field span {
      color: #8c8c92;
      font-size: .66rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    .ingredient-field.kcal input { background: #f8f4ff; color: #67578c; }
    .ingredient-field.protein input { background: #f2f6ff; color: #44658f; }
    .ingredient-field.carbs input { background: #fff8ef; color: #9b6a2b; }
    .ingredient-field.fat input { background: #fbf3fb; color: #805b80; }

    .ingredient-delete {
      width: 34px;
      height: 40px;
      border: 0;
      border-radius: 11px;
      background: white;
      color: #99999f;
      cursor: pointer;
    }

    .meal-prep-box {
      margin-top: 16px;
      padding: 13px;
      border-radius: 17px;
      background: #eef5f0;
      border: 1px solid rgba(62,116,80,.08);
    }

    .meal-prep-controls select {
      width: auto;
      min-width: 100px;
    }

    .meal-editor-actions {
      margin-top: 20px;
      padding-top: 18px;
      border-top: 1px solid rgba(30,30,40,.07);
    }

    .meal-delete-button {
      border: 0;
      border-radius: 13px;
      padding: 10px 13px;
      background: rgba(190,70,70,.08);
      color: #a44747;
      cursor: pointer;
    }

    @media (max-width: 1050px) {
      .nutrition-layout {
        grid-template-columns: 88px minmax(0,1fr);
      }

      .shopping-panel {
        grid-column: 2;
        position: static;
        max-height: none;
      }
    }

    @media (max-width: 720px) {
      .nutrition-shell { padding: 18px; }

      .nutrition-layout {
        grid-template-columns: 1fr;
      }

      .nutrition-day-rail {
        position: static;
        overflow-x: auto;
        padding: 9px;
      }

      .nutrition-rail-label { display: none; }

      .nutrition-days {
        flex-direction: row;
        width: max-content;
      }

      .nutrition-day-button {
        width: 68px;
      }

      .nutrition-day-button:hover,
      .nutrition-day-button.selected {
        transform: translateY(-2px);
      }

      .shopping-panel {
        grid-column: auto;
      }

      .nutrition-meals {
        grid-template-columns: 1fr;
      }

      .nutrition-macros {
        grid-template-columns: 1fr;
      }

      .ingredient-main-fields {
        grid-template-columns: 1fr 85px 80px 34px;
      }

      .ingredient-macro-fields {
        grid-template-columns: repeat(2,minmax(0,1fr));
      }

      .meal-prep-box,
      .meal-editor-actions {
        align-items: stretch;
        flex-direction: column;
      }

      .meal-editor-actions > div {
        width: 100%;
      }

      .meal-editor-actions > div button {
        flex: 1;
      }
    }


    /* Ernährung V13: 2-Tage-Meal-Prep und Wochenübersicht */
    .nutrition-shell {
      padding: 30px;
    }

    .nutrition-today-card {
      border-radius: 27px;
      padding: 20px;
      background:
        linear-gradient(135deg, rgba(241,248,243,.96), rgba(255,255,255,.90));
      border: 1px solid rgba(62,116,80,.10);
      box-shadow: 0 12px 30px rgba(30,50,36,.055);
      margin-bottom: 14px;
    }

    .nutrition-today-head,
    .nutrition-section-head,
    .nutrition-block-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .nutrition-today-head h2,
    .nutrition-section-head h2,
    .nutrition-block-summary h2 {
      margin: 3px 0 0;
      letter-spacing: -.04em;
    }

    .nutrition-today-head h2 {
      font-size: 1.45rem;
    }

    .nutrition-today-total {
      display: flex;
      align-items: baseline;
      gap: 5px;
      padding: 10px 14px;
      border-radius: 15px;
      background: rgba(255,255,255,.78);
      color: #496d55;
    }

    .nutrition-today-total strong {
      font-size: 1.5rem;
      letter-spacing: -.04em;
    }

    .nutrition-today-total span {
      font-size: .72rem;
      font-weight: 800;
    }

    .nutrition-today-body {
      display: grid;
      grid-template-columns: minmax(0,1fr) auto;
      gap: 16px;
      align-items: end;
      margin-top: 15px;
    }

    .nutrition-today-meals {
      display: grid;
      grid-template-columns: repeat(4,minmax(0,1fr));
      gap: 8px;
    }

    .today-meal {
      min-width: 0;
      padding: 11px 12px;
      border-radius: 15px;
      background: rgba(255,255,255,.72);
    }

    .today-meal span {
      display: block;
      color: #8b8b91;
      font-size: .65rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .05em;
    }

    .today-meal strong {
      display: block;
      margin-top: 4px;
      color: #3d4740;
      font-size: .84rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .nutrition-today-macros {
      display: flex;
      gap: 7px;
    }

    .today-macro {
      min-width: 82px;
      padding: 9px 10px;
      border-radius: 13px;
    }

    .today-macro span {
      display: block;
      font-size: .63rem;
      font-weight: 800;
      opacity: .75;
    }

    .today-macro strong {
      display: block;
      margin-top: 3px;
      font-size: .83rem;
    }

    .today-macro.protein { background: #edf4ff; color: #44658f; }
    .today-macro.carbs { background: #fff4e5; color: #986626; }
    .today-macro.fat { background: #f7edf7; color: #805b80; }

    .nutrition-week-section {
      border-radius: 27px;
      padding: 19px;
      background: rgba(255,255,255,.76);
      border: 1px solid rgba(30,30,40,.06);
      box-shadow: 0 10px 28px rgba(30,30,40,.045);
      margin-bottom: 14px;
    }

    .nutrition-section-head {
      margin-bottom: 13px;
    }

    .nutrition-section-head h2 {
      font-size: 1.28rem;
    }

    .two-day-note {
      padding: 7px 10px;
      border-radius: 11px;
      background: #edf5ef;
      color: #54715d;
      font-size: .7rem;
      font-weight: 800;
    }

    .nutrition-week-grid {
      display: grid;
      grid-template-columns: repeat(7,minmax(0,1fr));
      gap: 8px;
    }

    .week-food-day {
      min-width: 0;
      min-height: 198px;
      padding: 12px 10px;
      border: 1px solid rgba(30,30,40,.055);
      border-radius: 18px;
      background: #f8f8f9;
      color: #343438;
      cursor: pointer;
      text-align: left;
      transition: transform .16s ease, box-shadow .16s ease, background .16s ease;
      position: relative;
      overflow: hidden;
    }

    .week-food-day:hover {
      transform: translateY(-2px);
      box-shadow: 0 9px 20px rgba(30,30,40,.055);
    }

    .week-food-day.selected {
      box-shadow: inset 0 0 0 2px rgba(48,79,58,.24), 0 10px 24px rgba(48,79,58,.08);
      background: #f3f8f4;
    }

    .week-food-day.today::after {
      content: "Heute";
      position: absolute;
      top: 9px;
      right: 8px;
      padding: 4px 6px;
      border-radius: 8px;
      background: #2f4f3a;
      color: white;
      font-size: .55rem;
      font-weight: 850;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    .week-food-day.pair-0 { border-top: 3px solid #75977f; }
    .week-food-day.pair-1 { border-top: 3px solid #7188a7; }
    .week-food-day.pair-2 { border-top: 3px solid #a88967; }
    .week-food-day.pair-3 { border-top: 3px solid #8d789b; }

    .week-food-day-head {
      margin-bottom: 10px;
    }

    .week-food-weekday {
      color: #84848b;
      font-size: .65rem;
      text-transform: uppercase;
      letter-spacing: .07em;
      font-weight: 850;
    }

    .week-food-date {
      display: block;
      margin-top: 2px;
      font-size: 1.28rem;
      font-weight: 780;
      letter-spacing: -.05em;
    }

    .week-food-pair {
      margin-top: 5px;
      color: #98989e;
      font-size: .58rem;
      font-weight: 750;
    }

    .week-food-meals {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .week-food-meal span {
      display: block;
      color: #a0a0a6;
      font-size: .54rem;
      text-transform: uppercase;
      font-weight: 850;
      letter-spacing: .05em;
    }

    .week-food-meal strong {
      display: block;
      margin-top: 1px;
      color: #505056;
      font-size: .69rem;
      line-height: 1.15;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .nutrition-detail-layout {
      display: grid;
      grid-template-columns: minmax(0,1fr) 300px;
      gap: 14px;
      align-items: start;
    }

    .nutrition-block-summary {
      border-radius: 23px;
      padding: 17px 18px;
      background: rgba(255,255,255,.82);
      border: 1px solid rgba(30,30,40,.06);
      margin-bottom: 11px;
    }

    .nutrition-block-summary h2 {
      font-size: 1.25rem;
    }

    .nutrition-block-values {
      display: flex;
      gap: 7px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .nutrition-block-values > div {
      min-width: 72px;
      padding: 8px 9px;
      border-radius: 12px;
      background: #f3f0fa;
      color: #67578c;
      text-align: center;
    }

    .nutrition-block-values > div.protein { background: #eef4ff; color: #44658f; }
    .nutrition-block-values > div.carbs { background: #fff5e8; color: #9b6a2b; }
    .nutrition-block-values > div.fat { background: #f8eef8; color: #805b80; }

    .nutrition-block-values strong {
      display: block;
      font-size: .84rem;
    }

    .nutrition-block-values span {
      display: block;
      margin-top: 2px;
      font-size: .56rem;
      font-weight: 800;
    }

    .nutrition-meals {
      grid-template-columns: repeat(2,minmax(0,1fr));
      align-items: stretch;
    }

    .shopping-panel {
      top: 105px;
    }

    @media (max-width: 1100px) {
      .nutrition-week-grid {
        grid-template-columns: repeat(4,minmax(0,1fr));
      }

      .nutrition-detail-layout {
        grid-template-columns: 1fr;
      }

      .shopping-panel {
        position: static;
        max-height: none;
      }
    }

    @media (max-width: 780px) {
      .nutrition-today-body {
        grid-template-columns: 1fr;
      }

      .nutrition-today-meals {
        grid-template-columns: repeat(2,minmax(0,1fr));
      }

      .nutrition-today-macros {
        flex-wrap: wrap;
      }

      .nutrition-week-grid {
        grid-template-columns: repeat(2,minmax(0,1fr));
      }

      .nutrition-block-summary {
        align-items: flex-start;
        flex-direction: column;
      }

      .nutrition-block-values {
        justify-content: flex-start;
      }

      .nutrition-meals {
        grid-template-columns: 1fr;
      }
    }


    .nutrition-heading-actions {
      display: flex;
      gap: 9px;
      align-items: center;
    }

    .today-meal {
      cursor: pointer;
      transition: .16s ease;
      border: 1px solid transparent;
    }

    .today-meal:hover {
      transform: translateY(-1px);
      background: rgba(255,255,255,.95);
    }

    .today-meal.done {
      background: #e9f5ec;
      border-color: rgba(62,116,80,.12);
      box-shadow: inset 0 0 0 1px rgba(62,116,80,.05);
    }

    .today-meal.done span,
    .today-meal.done strong {
      color: #3f7450;
    }

    .today-meal-check {
      margin-top: 6px;
      font-size: .62rem;
      font-weight: 850;
      color: #4f7c5c;
    }

    .individual-day-button {
      margin-top: 8px;
      border: 0;
      background: transparent;
      color: #607b69;
      padding: 0;
      font-size: .72rem;
      font-weight: 800;
      cursor: pointer;
    }

    .individual-day-button.active {
      color: #2f4f3a;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .individual-badge {
      display: inline-flex;
      margin-top: 5px;
      padding: 4px 7px;
      border-radius: 8px;
      background: #edf5ef;
      color: #53715d;
      font-size: .58rem;
      font-weight: 850;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    .nutrition-generator-backdrop {
      position: fixed;
      inset: 0;
      z-index: 150;
      display: grid;
      place-items: center;
      padding: 24px;
      background: rgba(22,26,23,.30);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      opacity: 0;
      pointer-events: none;
      transition: opacity .18s ease;
    }

    .nutrition-generator-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }

    .nutrition-generator-card {
      width: min(620px,100%);
      max-height: calc(100vh - 32px);
      overflow-y: auto;
      border-radius: 29px;
      padding: 24px;
      background: rgba(252,253,252,.985);
      border: 1px solid rgba(30,30,40,.08);
      box-shadow: 0 30px 90px rgba(20,25,21,.20);
      transform: translateY(10px) scale(.985);
      transition: transform .18s ease;
    }

    .nutrition-generator-backdrop.open .nutrition-generator-card {
      transform: translateY(0) scale(1);
    }

    .generator-intro {
      margin: 18px 0;
      padding: 12px 13px;
      border-radius: 15px;
      background: #f1f6f2;
      color: #637267;
      font-size: .82rem;
      line-height: 1.5;
    }

    .generator-field {
      display: flex;
      flex-direction: column;
      gap: 7px;
      color: #77777d;
      font-size: .8rem;
      font-weight: 700;
    }

    .generator-field textarea {
      width: 100%;
      resize: vertical;
      min-height: 120px;
      border: 1px solid rgba(30,30,40,.10);
      border-radius: 15px;
      padding: 12px 13px;
      background: white;
      color: #333338;
      outline: none;
      font: inherit;
    }

    .generator-field small {
      color: #9a9aa0;
      font-weight: 500;
    }

    .generator-options {
      display: grid;
      grid-template-columns: repeat(2,minmax(0,1fr));
      gap: 10px;
      margin-top: 16px;
    }

    .generator-options label {
      display: flex;
      flex-direction: column;
      gap: 6px;
      color: #77777d;
      font-size: .76rem;
      font-weight: 700;
    }

    .generator-options input {
      width: 100%;
      border: 1px solid rgba(30,30,40,.10);
      border-radius: 13px;
      padding: 10px 11px;
      background: white;
      color: #333338;
      outline: none;
    }

    .generator-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 20px;
      padding-top: 18px;
      border-top: 1px solid rgba(30,30,40,.07);
    }

    .generator-target-hint { margin: 12px 0 0; font-size: .76rem; line-height: 1.45; color: #77736d; }
    .generator-error { margin: 12px 0 0; padding: 10px 12px; border-radius: 12px; background: #f8eae7; color: #924c44; font-size: .8rem; line-height: 1.45; }
    .generator-error[hidden] { display: none; }

    @media (max-width: 700px) {
      .nutrition-heading-actions {
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .generator-options {
        grid-template-columns: 1fr;
      }
    }


    .generator-food-grid {
      display: grid;
      grid-template-columns: repeat(2,minmax(0,1fr));
      gap: 12px;
    }

    .ingredient-nutrition-toggle {
      width: 100%;
      margin-top: 9px;
      border: 0;
      border-radius: 12px;
      background: rgba(255,255,255,.72);
      padding: 9px 10px;
      display: grid;
      grid-template-columns: 1fr auto auto;
      align-items: center;
      gap: 9px;
      color: #6d6d73;
      cursor: pointer;
      text-align: left;
    }
