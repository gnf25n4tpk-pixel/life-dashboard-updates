    }

    body.dark-mode :is(
      .home-day-card,.home-mini-row,.home-todo-item,.home-agenda-row,
      .gym-day-card,.gym-exercise-card,.exercise-set-row,.exercise-history,
      .nutrition-week-card,.today-meal,.shopping-item,
      .calendar-day-cell,.calendar-agenda-item,.calendar-apple-status,
      .ingredient-editor-card
    ) {
