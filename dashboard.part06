      color: white !important;
    }

    body.dark-mode .calendar-day-cell {
      background: #35353a !important;
      border-color: rgba(255,255,255,.055) !important;
      color: #eeeeF2 !important;
    }

    body.dark-mode .calendar-day-cell:hover {
