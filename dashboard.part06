      border-color: rgba(255,255,255,.06) !important;
      color: #eeeeF2 !important;
    }

    body.dark-mode .gym-day-card.selected,
    body.dark-mode .gym-day-card.today {
      background: #334256 !important;
      color: white !important;
      box-shadow: inset 0 0 0 2px rgba(121,157,200,.18) !important;
