      gap: 6px;
      max-height: 440px;
      overflow: auto;
      margin-top: 10px;
    }

    .global-search-result {
      width: 100%;
      border: 0;
      border-radius: 12px;
      background: #f7f7f8;
      padding: 9px 10px;
      display: grid;
      grid-template-columns: 80px minmax(0,1fr);
      gap: 10px;
      text-align: left;
      cursor: pointer;
    }

    .global-search-result:hover { background: #efeff2; }

    .global-search-result span {
      color: #929298;
      font-size: .62rem;
      font-weight: 800;
    }

    .global-search-result strong {
      min-width: 0;
      color: #4a4a50;
      font-size: .73rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .global-search-empty {
      padding: 20px 5px;
      color: #97979d;
      font-size: .74rem;
    }

    /* Quick Add */
    .quick-add-choice-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 18px;
    }

    .quick-add-choice-grid button {
      border: 1px solid rgba(30,30,40,.055);
      border-radius: 16px;
      background: #f6f6f7;
      min-height: 105px;
      padding: 14px;
      text-align: left;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .quick-add-choice-grid button:hover {
      background: #efeff2;
    }

    .quick-add-choice-grid button > span {
      color: #607892;
      font-size: 1.15rem;
    }

    .quick-add-choice-grid strong { color: #444449; }
    .quick-add-choice-grid small { color: #97979d; }

    /* Dark mode */
    body.dark-mode {
      background:
        radial-gradient(circle at top left, rgba(57,57,62,.92), transparent 34%),
        linear-gradient(180deg,#29292d 0%,#1f1f22 100%);
      color: #ececf0;
    }

    body.dark-mode .topbar,
    body.dark-mode .home-calendar-card,
    body.dark-mode .home-summary-card,
    body.dark-mode .home-organizer-card,
    body.dark-mode .home-music-card,
    body.dark-mode .finance-shell,
    body.dark-mode .gym-shell,
    body.dark-mode .nutrition-shell,
    body.dark-mode .calendar-shell,
    body.dark-mode .home-modal-card {
      background: rgba(44,44,49,.88);
      border-color: rgba(255,255,255,.07);
      color: #ececf0;
    }

    body.dark-mode .home-day-card,
    body.dark-mode .home-mini-row,
    body.dark-mode .home-todo-item,
    body.dark-mode .home-note,
    body.dark-mode .home-todo-add input,
    body.dark-mode .home-agenda-row,
    body.dark-mode .settings-card,
    body.dark-mode .backup-card,
    body.dark-mode .global-search-input,
    body.dark-mode .global-search-result,
    body.dark-mode .quick-add-choice-grid button,
    body.dark-mode .dashboard-stat-strip > div,
    body.dark-mode .calendar-day-cell,
    body.dark-mode .calendar-agenda-item,
    body.dark-mode .calendar-apple-status,
    body.dark-mode .music-controls button {
      background: #35353a;
      color: #ededf0;
      border-color: rgba(255,255,255,.06);
    }

    body.dark-mode .home-day-card.selected,
    body.dark-mode .calendar-day-cell.selected {
      background: #364355;
    }

    body.dark-mode .home-card-kicker,
    body.dark-mode .calendar-kicker,
    body.dark-mode .dashboard-stat-strip span,
    body.dark-mode .home-mini-row span,
    body.dark-mode .home-agenda-time,
    body.dark-mode .date-line,
    body.dark-mode .calendar-heading p {
      color: #a9a9b0;
    }

    body.dark-mode .home-mini-row strong,
    body.dark-mode .home-summary-head h3,
    body.dark-mode .home-organizer-head h3,
    body.dark-mode .music-track-copy strong,
    body.dark-mode .dashboard-stat-strip strong,
    body.dark-mode .calendar-agenda-top strong,
    body.dark-mode .calendar-heading h1 {
      color: #eeeeF2;
    }

    body.dark-mode .tab,
    body.dark-mode .brand,
    body.dark-mode .compact-datetime {
      color: #d8d8dd;
    }

    body.dark-mode .tab.active {
      background: #e9e9ed;
      color: #27272b;
    }

    body.dark-mode .topbar-action-button,
    body.dark-mode .topbar-settings-button {
      background: #39393e;
      color: #dddde1;
      border-color: rgba(255,255,255,.06);
    }

    body.dark-mode .music-controls .music-play-button {
      background: #ececf0;
      color: #27272b;
    }

    @media (max-width: 980px) {
      .dashboard-stat-strip {
        grid-template-columns: 1fr;
      }
    }


    /* ===== Desktop V2: vollständiger Dark Mode ===== */
    body.dark-mode {
      --bg: #1d1d20;
      --panel: rgba(42,42,47,.94);
      --panel-strong: #45454c;
      --text: #f1f1f3;
      --muted: #aaaab2;
      --line: rgba(255,255,255,.085);
      --shadow: 0 18px 50px rgba(0,0,0,.22);
      --shadow-soft: 0 8px 24px rgba(0,0,0,.18);
      --red-line: rgba(216,115,115,.15);
      background:
        radial-gradient(circle at top left, rgba(62,62,68,.84), transparent 35%),
        linear-gradient(180deg,#242428 0%,#1c1c1f 100%) !important;
      color: #f1f1f3;
    }

    body.dark-mode.finance-active {
      background:
        radial-gradient(circle at top left, rgba(62,62,68,.84), transparent 35%),
        linear-gradient(180deg,#242428 0%,#1c1c1f 100%) !important;
    }

    body.dark-mode .topbar,
    body.dark-mode.finance-active .topbar {
      background: rgba(37,37,42,.90) !important;
      border-color: rgba(255,255,255,.075) !important;
      box-shadow: 0 10px 30px rgba(0,0,0,.22);
    }

    body.dark-mode .tabs {
      background: #2c2c31 !important;
      border-color: rgba(255,255,255,.07) !important;
    }

    body.dark-mode .tab {
      color: #b8b8c0 !important;
      background: transparent !important;
    }

    body.dark-mode .tab:hover {
      color: white !important;
      background: #37373d !important;
    }

    body.dark-mode .tab.active,
    body.dark-mode.finance-active .tab.active {
      background: #505058 !important;
      color: #fff !important;
      box-shadow: 0 5px 16px rgba(0,0,0,.22) !important;
    }

    body.dark-mode .brand-dot {
      background: #ececf0;
      box-shadow: 0 0 0 6px rgba(255,255,255,.07);
    }

    body.dark-mode .compact-datetime,
    body.dark-mode .brand {
      color: #ececf0 !important;
    }

    body.dark-mode :is(
      .finance-shell,.gym-shell,.nutrition-shell,.calendar-shell,
      .home-calendar-card,.home-summary-card,.home-organizer-card,.home-music-card,
      .content-card,.calendar-month-panel,.calendar-agenda-panel,
      .gym-calendar-card,.gym-workout-card,.nutrition-today-card,.nutrition-week-section,
      .nutrition-meal-card,.shopping-panel,.money-panel,.balance-card,
      .dashboard-stat-strip > div,.calendar-apple-status,.exercise-history,
      .home-modal-card,.modal-card,.gym-editor-card,.exercise-editor-card,
      .meal-editor-card,.nutrition-generator-card,.settings-card,.backup-card
    ) {
      background: #2f2f34 !important;
      border-color: rgba(255,255,255,.07) !important;
      color: #ededf1 !important;
      box-shadow: 0 12px 30px rgba(0,0,0,.16) !important;
    }

    body.dark-mode .main-balance {
      background: linear-gradient(145deg,#3a3033,#332a2d) !important;
    }

    body.dark-mode .income-panel {
      background: linear-gradient(145deg,#2d3831,#29342e) !important;
    }

    body.dark-mode :is(
      .money-row,.home-day-card,.home-mini-row,.home-todo-item,.home-agenda-row,
      .gym-day-card,.ingredient-editor-card,.exercise-set-row,
      .global-search-result,.quick-add-choice-grid button,.shopping-item
    ) {
      background: #39393f !important;
      border-color: rgba(255,255,255,.06) !important;
      color: #eeeeF2 !important;
    }

    body.dark-mode .gym-day-card.selected,
    body.dark-mode .gym-day-card.today {
      background: #334256 !important;
      color: white !important;
      box-shadow: inset 0 0 0 2px rgba(121,157,200,.18) !important;
    }

    body.dark-mode .nutrition-day-button {
      color: #b8b8c0 !important;
    }

    body.dark-mode .nutrition-day-button:hover,
    body.dark-mode .nutrition-day-button.today:not(.selected) {
