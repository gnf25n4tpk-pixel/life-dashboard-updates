    }

    body.dark-mode .gym-day-card.selected {
      background: #3a424c !important;
      color: #dce3ea !important;
      box-shadow: inset 0 0 0 1px rgba(126,153,181,.16) !important;
    }

    body.dark-mode .gym-day-card.today:not(.selected) {
      background: #363b3c !important;
      color: #d8dfda !important;
    }

    body.dark-mode .nutrition-week-card.selected {
      background: #37413a !important;
      box-shadow: inset 0 0 0 1px rgba(116,153,126,.14) !important;
    }

    body.dark-mode .calendar-day-cell.selected {
      background: #39414b !important;
      box-shadow: inset 0 0 0 1px rgba(117,146,178,.13) !important;
    }

    body.dark-mode .calendar-day-cell.today .calendar-day-number,
    body.dark-mode .home-today-badge {
      background: #496456 !important;
      color: #e7ece9 !important;
    }

    body.dark-mode :is(
      .gym-primary-button,.nutrition-primary-button,.calendar-primary-button,
      .home-save-button,.home-add-button
    ) {
      background: #4a5868 !important;
      color: #e8eaed !important;
      box-shadow: none !important;
    }

    body.dark-mode :is(
      .gym-secondary-button,.nutrition-secondary-button,.calendar-secondary-button,
      .calendar-today-button,.home-small-button,.shopping-clear
    ) {
      background: #393a40 !important;
      color: #bfc0c6 !important;
      border-color: rgba(255,255,255,.04) !important;
    }

    body.dark-mode :is(
      .plan-picker select,.ingredient-field input,.ingredient-field select,
      .exercise-name-field input,.exercise-set-row input,
      .generator-field textarea,.generator-options input,
      .home-todo-add input,.home-note,.global-search-input
    ) {
      background: #292a2f !important;
      color: #d7d8dc !important;
      border-color: rgba(255,255,255,.05) !important;
    }

    body.dark-mode :is(
      .home-modal-card,.gym-editor-card,.exercise-editor-card,
      .meal-editor-card,.nutrition-generator-card
    ) {
      background: #303136 !important;
      border-color: rgba(255,255,255,.045) !important;
      color: #d9dade !important;
      box-shadow: 0 24px 70px rgba(0,0,0,.28) !important;
    }

    body.dark-mode .modal-card {
      background: #303136 !important;
      border-color: rgba(255,255,255,.045) !important;
      color: #d9dade !important;
    }

    body.dark-mode .modal-field {
      background: #292a2f !important;
      border-color: rgba(255,255,255,.05) !important;
      box-shadow: none !important;
    }

    body.dark-mode .modal-field span {
      color: #9b9da5 !important;
    }

    body.dark-mode .modal-field input {
      background: transparent !important;
      color: #d9dade !important;
    }

    body.dark-mode .music-controls button {
      background: #393a40 !important;
      color: #c7c8cd !important;
    }

    body.dark-mode .music-controls .music-play-button {
      background: #d9dade !important;
      color: #2d2e33 !important;
    }

    body.dark-mode .music-connect-button {
      background: #3b3437 !important;
      color: #c6a9b0 !important;
    }


    /* ===== Update-System ===== */
    .update-settings-card {
      align-items: stretch;
      flex-direction: column;
    }

    .update-settings-copy {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .update-feed-field {
      display: flex;
      flex-direction: column;
      gap: 5px;
      width: 100%;
    }

    .update-feed-field > span {
      color: #85858b;
      font-size: .64rem;
      font-weight: 800;
    }

    .update-feed-field input {
      width: 100%;
      border: 1px solid rgba(30,30,40,.08);
      border-radius: 11px;
      background: white;
      padding: 9px 10px;
      color: #444449;
      font: inherit;
      font-size: .68rem;
      outline: none;
    }

    .update-settings-actions {
      display: flex;
      gap: 7px;
      align-items: center;
      flex-wrap: wrap;
    }

    .update-auto-toggle {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 9px;
      border-radius: 10px;
      background: #ececef;
      color: #68686f;
      font-size: .66rem;
      font-weight: 800;
      cursor: pointer;
    }

    .update-auto-toggle input {
      margin: 0;
      accent-color: #526b87;
    }

    body.dark-mode .update-feed-field input {
      background: #292a2f !important;
      color: #d7d8dc !important;
      border-color: rgba(255,255,255,.05) !important;
    }

    body.dark-mode .update-auto-toggle {
      background: #393a40 !important;
      color: #bfc0c6 !important;
    }

    .hidden { display: none !important; }

    @media (max-width: 980px) {
      .topbar { grid-template-columns: 1fr; align-items: stretch; }
      .brand, .compact-datetime, .tabs { justify-self: stretch; }
      .compact-datetime { text-align: left; min-width: 0; }
      .tabs { width: 100%; overflow-x: auto; justify-content: flex-start; }
      .finance-summary { grid-template-columns: 1fr; }
      .finance-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 700px) {
      .app-shell { width: min(100% - 22px, 1180px); }
      .week-grid {
        grid-template-columns: repeat(7, minmax(72px,1fr));
        overflow-x: auto;
      }
      .finance-shell { padding: 18px; }
      .finance-heading { flex-direction: column; }
      .quick-add { grid-template-columns: 1fr; }
      .quick-add button { padding: 10px 13px; }
    }
  

    /* ===== V12 visual color pass ===== */
    :root {
      --finance-accent: #a6545d;
      --finance-soft: #f7ecee;
      --finance-line: rgba(166,84,93,.16);
      --finance-ink: #5f3940;

      --gym-accent: #5b7696;
      --gym-soft: #edf3f8;
      --gym-line: rgba(91,118,150,.16);
      --gym-ink: #40566f;

      --nutrition-accent: #557a61;
      --nutrition-soft: #eef5f0;
      --nutrition-line: rgba(85,122,97,.16);
      --nutrition-ink: #3f5f49;

      --calendar-accent: #7076a0;
      --calendar-soft: #eff1f8;
      --calendar-line: rgba(112,118,160,.16);
      --calendar-ink: #51577d;
    }

    .tab.active[data-tab="finanzen"] {
      background: linear-gradient(180deg, #fff8f9 0%, var(--finance-soft) 100%);
      color: var(--finance-ink);
      box-shadow: 0 6px 18px rgba(166,84,93,.12);
    }

    .tab.active[data-tab="gym"] {
      background: linear-gradient(180deg, #f9fbfd 0%, var(--gym-soft) 100%);
      color: var(--gym-ink);
      box-shadow: 0 6px 18px rgba(91,118,150,.12);
    }

    .tab.active[data-tab="ernaehrung"] {
      background: linear-gradient(180deg, #fbfdfb 0%, var(--nutrition-soft) 100%);
      color: var(--nutrition-ink);
      box-shadow: 0 6px 18px rgba(85,122,97,.12);
    }

    .tab.active[data-tab="kalender"] {
      background: linear-gradient(180deg, #fafbfe 0%, var(--calendar-soft) 100%);
      color: var(--calendar-ink);
      box-shadow: 0 6px 18px rgba(112,118,160,.12);
    }

    .home-calendar-card {
      background: linear-gradient(180deg, rgba(255,255,255,.86) 0%, rgba(244,246,252,.92) 100%);
      border-color: rgba(112,118,160,.11);
      box-shadow: 0 14px 34px rgba(79,85,123,.07);
    }

    .home-summary-card.agenda {
      background: linear-gradient(180deg, rgba(255,255,255,.90) 0%, rgba(243,245,251,.95) 100%);
      border: 1px solid rgba(112,118,160,.10);
      box-shadow: 0 10px 28px rgba(79,85,123,.06);
    }

    .home-summary-card.nutrition {
      background: linear-gradient(180deg, rgba(252,254,252,.92) 0%, rgba(238,245,240,.96) 100%);
      border: 1px solid rgba(85,122,97,.10);
      box-shadow: 0 10px 28px rgba(63,95,73,.06);
    }

    .home-summary-card.gym {
      background: linear-gradient(180deg, rgba(251,253,255,.92) 0%, rgba(237,243,248,.96) 100%);
      border: 1px solid rgba(91,118,150,.10);
      box-shadow: 0 10px 28px rgba(64,86,111,.06);
    }

    .home-summary-card.agenda .home-card-kicker { color: var(--calendar-accent); }
    .home-summary-card.nutrition .home-card-kicker { color: var(--nutrition-accent); }
    .home-summary-card.gym .home-card-kicker { color: var(--gym-accent); }

    .home-summary-card.agenda .home-arrow { color: var(--calendar-accent); }
    .home-summary-card.nutrition .home-arrow { color: var(--nutrition-accent); }
    .home-summary-card.gym .home-arrow { color: var(--gym-accent); }

    .home-summary-card.agenda:hover,
    .home-summary-card.nutrition:hover,
    .home-summary-card.gym:hover,
    .home-music-card:hover,
    .home-organizer-card:hover,
    .home-calendar-card:hover {
      transform: translateY(-2px);
      filter: saturate(1.02);
    }

    .home-music-card {
      background: linear-gradient(180deg, rgba(255,255,255,.86) 0%, rgba(245,241,247,.94) 100%);
      border-color: rgba(152,116,158,.11);
    }

    .home-organizer-card {
      background: linear-gradient(180deg, rgba(255,255,255,.86) 0%, rgba(245,246,248,.94) 100%);
      border: 1px solid rgba(30,30,40,.06);
      box-shadow: 0 10px 28px rgba(30,30,40,.045);
    }

    .finance-shell {
      background: linear-gradient(180deg, rgba(255,249,249,.82) 0%, rgba(255,255,255,.72) 100%);
      border-color: rgba(166,84,93,.10);
    }

    .finance-eyebrow { color: var(--finance-accent); }

    .balance-card,
    .money-panel,
    .finance-list {
      border-color: rgba(166,84,93,.10);
    }

    .soft-button:hover,
    .edit-balance:hover,
    .money-edit:hover,
    .list-add:hover,
    .list-delete:hover {
      filter: brightness(.98);
    }

    .gym-shell {
      background: linear-gradient(180deg, rgba(244,248,252,.84) 0%, rgba(255,255,255,.74) 100%);
      border-color: rgba(91,118,150,.10);
    }

    .gym-eyebrow,
    .gym-kicker,
    .gym-day-card.selected .gym-day-name { color: var(--gym-accent); }

    .gym-stat-strip > div,
    .gym-calendar-card,
    .gym-workout-card,
    .gym-panel {
      border-color: var(--gym-line);
    }

    .gym-primary-button,
    .gym-add-exercise,
    .exercise-add-set,
    .exercise-editor-save {
      background: var(--gym-accent);
      color: white;
      box-shadow: 0 10px 22px rgba(91,118,150,.16);
    }

    .gym-secondary-button,
    .plan-picker select,
    .gym-day-card {
      background: linear-gradient(180deg, white 0%, var(--gym-soft) 100%);
      border-color: var(--gym-line);
    }

    .gym-day-card.selected {
      background: linear-gradient(180deg, #f9fbfd 0%, #e3edf6 100%);
      box-shadow: inset 0 0 0 2px rgba(91,118,150,.18), 0 8px 22px rgba(91,118,150,.08);
    }

    .gym-session-badge {
      background: var(--gym-soft);
      color: var(--gym-ink);
      border: 1px solid var(--gym-line);
    }

    .nutrition-shell {
      background: linear-gradient(180deg, rgba(246,251,247,.84) 0%, rgba(255,255,255,.74) 100%);
      border-color: rgba(85,122,97,.10);
    }

    .nutrition-eyebrow,
    .nutrition-kicker { color: var(--nutrition-accent); }

    .nutrition-day-rail,
    .nutrition-day-summary,
    .shopping-panel,
    .nutrition-meal-card,
    .nutrition-today-card,
    .nutrition-week-section,
    .nutrition-stat-strip > div {
      border-color: var(--nutrition-line);
    }

    .nutrition-primary-button,
    .nutrition-add-meal,
    .meal-editor-save,
    .generator-save,
    .shopping-clear {
      background: var(--nutrition-accent);
      color: white;
      box-shadow: 0 10px 22px rgba(85,122,97,.16);
    }

    .nutrition-secondary-button,
    .nutrition-day-button {
      border-color: var(--nutrition-line);
    }

    .nutrition-day-button.selected {
      background: linear-gradient(180deg, #5e886b 0%, #4e735a 100%);
      box-shadow: 0 10px 22px rgba(85,122,97,.18);
    }

    .today-macro.protein,
    .nutrition-total-kcal,
    .shopping-group-title {
      color: var(--nutrition-ink);
    }

    .calendar-shell {
      background: linear-gradient(180deg, rgba(246,248,252,.84) 0%, rgba(255,255,255,.74) 100%);
      border-color: rgba(112,118,160,.10);
    }

    .calendar-kicker,
    .calendar-heading p,
    .calendar-source.gym,
    .calendar-source.nutrition,
    .calendar-source.personal,
    .calendar-source.apple {
      color: var(--calendar-ink);
    }

    .calendar-month-panel,
    .calendar-agenda-panel,
    .calendar-apple-status {
      border-color: var(--calendar-line);
    }

    .calendar-primary-button {
      background: var(--calendar-accent);
      box-shadow: 0 10px 22px rgba(112,118,160,.16);
    }

    .calendar-secondary-button,
    .calendar-today-button,
    .calendar-month-navigation button,
    .calendar-day-cell {
      border-color: var(--calendar-line);
    }

    .calendar-day-cell.selected {
      background: linear-gradient(180deg, #fafbfe 0%, #e9edf8 100%);
      box-shadow: inset 0 0 0 2px rgba(112,118,160,.16);
    }

    .calendar-day-cell.today .calendar-day-number {
      background: var(--calendar-accent);
    }

    .calendar-source.personal,
    .calendar-cell-event.personal { background: #eef4ef; color: #5e7766; }
    .calendar-source.apple,
    .calendar-cell-event.apple { background: #f6edf3; color: #8b5f78; }
    .calendar-source.gym,
    .calendar-cell-event.gym { background: var(--gym-soft); color: var(--gym-ink); }
    .calendar-source.nutrition,
    .calendar-cell-event.nutrition { background: #f7f3ea; color: #8c6d42; }

    .dashboard-stat-strip > div {
      background: rgba(255,255,255,.74);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.72);
    }

  

    /* ===== V13 stronger visual identity ===== */
    .home-calendar-card,
    .home-summary-card,
    .home-music-card,
    .home-organizer-card,
    .gym-calendar-card,
    .gym-workout-card,
    .nutrition-today-card,
    .nutrition-week-section,
    .calendar-month-panel,
    .calendar-agenda-panel {
      position: relative;
      overflow: hidden;
    }

    .home-calendar-card::before,
    .home-summary-card::before,
    .home-music-card::before,
    .home-organizer-card::before,
