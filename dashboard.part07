    .gym-calendar-card::before,
    .gym-workout-card::before,
    .nutrition-today-card::before,
    .nutrition-week-section::before,
    .calendar-month-panel::before,
    .calendar-agenda-panel::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: 4px;
      border-radius: 4px;
      opacity: .85;
      pointer-events: none;
    }

    .home-calendar-card::before,
    .home-summary-card.agenda::before,
    .calendar-month-panel::before,
    .calendar-agenda-panel::before {
      background: linear-gradient(180deg, #8a8fbd, #676d97);
    }

    .home-summary-card.gym::before,
    .gym-calendar-card::before,
    .gym-workout-card::before {
      background: linear-gradient(180deg, #6f8eaf, #527092);
    }

    .home-summary-card.nutrition::before,
    .nutrition-today-card::before,
    .nutrition-week-section::before {
      background: linear-gradient(180deg, #6e9778, #4f765b);
    }

    .home-music-card::before {
      background: linear-gradient(180deg, #a17aa9, #806188);
    }

    .home-organizer-card::before {
      background: linear-gradient(180deg, #9297a6, #737887);
    }

    .home-calendar-card {
      background:
        radial-gradient(circle at 92% 12%, rgba(123,128,176,.14), transparent 26%),
        linear-gradient(180deg, rgba(255,255,255,.91) 0%, rgba(238,241,250,.98) 100%);
    }

    .home-summary-card.agenda {
      background:
        radial-gradient(circle at 100% 0%, rgba(123,128,176,.12), transparent 42%),
        linear-gradient(180deg, #fdfdff 0%, #eef0f7 100%);
    }

    .home-summary-card.gym {
      background:
        radial-gradient(circle at 100% 0%, rgba(91,118,150,.14), transparent 42%),
        linear-gradient(180deg, #fbfdff 0%, #eaf2f8 100%);
    }

    .home-summary-card.nutrition {
      background:
        radial-gradient(circle at 100% 0%, rgba(85,122,97,.14), transparent 42%),
        linear-gradient(180deg, #fcfefc 0%, #eaf3ed 100%);
    }

    .home-music-card {
      background:
        radial-gradient(circle at 100% 0%, rgba(153,111,162,.14), transparent 42%),
        linear-gradient(180deg, #fefcfe 0%, #f0eaf2 100%);
    }

    .home-organizer-card {
      background:
        radial-gradient(circle at 100% 0%, rgba(115,120,135,.10), transparent 42%),
        linear-gradient(180deg, #fdfdfe 0%, #f0f1f4 100%);
    }

    .home-summary-card.agenda:hover,
    .home-summary-card.gym:hover,
    .home-summary-card.nutrition:hover {
      transform: translateY(-3px) scale(1.005);
      box-shadow: 0 16px 34px rgba(30,30,40,.08);
    }

    .home-summary-card .home-card-kicker,
    .home-music-card .home-card-kicker,
    .home-organizer-card .home-card-kicker {
      font-weight: 900;
      letter-spacing: .075em;
    }

    .home-summary-card.agenda h3,
    .home-calendar-card h2 { color: #4f5578; }
    .home-summary-card.gym h3 { color: #3f5974; }
    .home-summary-card.nutrition h3 { color: #3f624a; }
    .home-music-card h3 { color: #674f6d; }

    .home-add-button {
      background: linear-gradient(180deg, #8086b5, #686e9b);
      color: white;
      box-shadow: 0 8px 18px rgba(104,110,155,.18);
    }

    .home-todo-add button {
      background: linear-gradient(180deg, #7f91a9, #687a94);
      color: white;
      box-shadow: 0 8px 16px rgba(104,122,148,.13);
    }

    .home-mini-row,
    .home-agenda-row,
    .home-todo-item {
      background: rgba(255,255,255,.67);
      border: 1px solid rgba(255,255,255,.74);
    }

    .finance-shell {
      box-shadow: 0 22px 58px rgba(107,61,68,.075);
    }

    .main-balance {
      background:
        radial-gradient(circle at 92% 12%, rgba(166,84,93,.10), transparent 30%),
        linear-gradient(145deg, #fffafa, #f4dfe2);
    }

    .gym-shell {
      background:
        radial-gradient(circle at 95% 0%, rgba(91,118,150,.14), transparent 30%),
        linear-gradient(180deg, rgba(241,247,252,.94) 0%, rgba(255,255,255,.82) 46%);
    }

    .gym-heading h1 { color: #334c66; }
    .gym-stat-strip > div:nth-child(1) { background: #edf4fa; }
    .gym-stat-strip > div:nth-child(2) { background: #eaf1f7; }
    .gym-stat-strip > div:nth-child(3) { background: #f1f5f9; }
    .gym-stat-strip strong { color: #3d5874; }

    .gym-calendar-card,
    .gym-workout-card {
      background:
        radial-gradient(circle at 100% 0%, rgba(91,118,150,.08), transparent 36%),
        rgba(255,255,255,.85);
    }

    .gym-primary-button,
    .gym-add-exercise {
      background: linear-gradient(180deg, #6f8eaf 0%, #587797 100%);
    }

    .gym-secondary-button:hover,
    .gym-day-card:hover {
      background: #e9f1f8;
    }

    .gym-day-card.today {
      background: linear-gradient(180deg, #6688a8 0%, #4f718f 100%) !important;
      box-shadow: 0 12px 24px rgba(79,113,143,.20);
    }

    .nutrition-shell {
      background:
        radial-gradient(circle at 95% 0%, rgba(85,122,97,.14), transparent 30%),
        linear-gradient(180deg, rgba(243,249,245,.94) 0%, rgba(255,255,255,.82) 46%);
    }

    .nutrition-heading h1 { color: #355a41; }
    .nutrition-stat-strip > div:nth-child(1) { background: #edf5ef; }
    .nutrition-stat-strip > div:nth-child(2) { background: #e9f2ec; }
    .nutrition-stat-strip > div:nth-child(3) { background: #f2f6f3; }
    .nutrition-stat-strip strong { color: #42634c; }

    .nutrition-today-card,
    .nutrition-week-section,
    .nutrition-meal-card,
    .shopping-panel {
      background:
        radial-gradient(circle at 100% 0%, rgba(85,122,97,.07), transparent 34%),
        rgba(255,255,255,.86);
    }

    .nutrition-primary-button {
      background: linear-gradient(180deg, #6d9678 0%, #557c61 100%);
    }

    .nutrition-day-button.selected {
      background: linear-gradient(180deg, #699276 0%, #50745b 100%);
      box-shadow: 0 12px 24px rgba(80,116,91,.20);
    }

    .today-macro.protein { background: #edf5ef; }
    .today-macro.carbs { background: #f5f0e8; }
    .today-macro.fat { background: #f3edf3; }

    .calendar-shell {
      background:
        radial-gradient(circle at 95% 0%, rgba(112,118,160,.15), transparent 30%),
        linear-gradient(180deg, rgba(244,246,252,.95) 0%, rgba(255,255,255,.82) 46%);
    }

    .calendar-heading h1 { color: #484f7b; }
    .calendar-primary-button {
      background: linear-gradient(180deg, #858bb8 0%, #696f9c 100%);
    }

    .calendar-month-panel,
    .calendar-agenda-panel {
      background:
        radial-gradient(circle at 100% 0%, rgba(112,118,160,.08), transparent 36%),
        rgba(255,255,255,.87);
    }

    .calendar-day-cell:hover {
      background: #f2f3fa;
    }

    .calendar-day-cell.selected {
      background: linear-gradient(180deg, #f7f8fd 0%, #e4e7f4 100%);
      box-shadow: inset 0 0 0 2px rgba(112,118,160,.20), 0 8px 18px rgba(112,118,160,.07);
    }

    .calendar-day-cell.today .calendar-day-number {
      background: linear-gradient(180deg, #8187b3 0%, #666c97 100%);
      box-shadow: 0 6px 14px rgba(102,108,151,.18);
    }

    .calendar-source {
      border: 1px solid rgba(30,30,40,.035);
      font-weight: 800;
    }

    /* keep dark mode toned down; color identity stays mostly in accents */
    body.dark-mode .home-summary-card::before,
    body.dark-mode .home-calendar-card::before,
    body.dark-mode .home-music-card::before,
    body.dark-mode .home-organizer-card::before,
    body.dark-mode .gym-calendar-card::before,
    body.dark-mode .gym-workout-card::before,
    body.dark-mode .nutrition-today-card::before,
    body.dark-mode .nutrition-week-section::before,
    body.dark-mode .calendar-month-panel::before,
    body.dark-mode .calendar-agenda-panel::before {
      opacity: .55;
    }

  

    /* ===== V14 visual hierarchy pass ===== */
    #homeView {
      position: relative;
    }

    .home-hero {
      min-height: 260px;
      padding: 34px 26px 28px;
      border-radius: 34px;
      background:
        radial-gradient(circle at 85% 22%, rgba(112,118,160,.14), transparent 28%),
        radial-gradient(circle at 15% 18%, rgba(85,122,97,.08), transparent 26%),
        linear-gradient(180deg, rgba(255,255,255,.92) 0%, rgba(246,248,252,.88) 100%);
      border: 1px solid rgba(255,255,255,.9);
      box-shadow: 0 18px 42px rgba(42,46,70,.06);
      overflow: hidden;
      position: relative;
    }

    .home-hero::after {
      content: "D";
      position: absolute;
      right: 26px;
      bottom: -18px;
      font-family: "Georgia", "Times New Roman", serif;
      font-style: italic;
      font-size: 8.2rem;
      line-height: 1;
      color: rgba(75,82,120,.08);
      pointer-events: none;
      transform: rotate(-5deg);
    }

    .home-hero h1 {
      font-size: clamp(5.2rem, 11vw, 9rem);
      letter-spacing: -.085em;
    }

    .date-line {
      font-size: .98rem;
      color: #5e6379;
    }

    .home-settings-button {
      width: 46px;
      height: 46px;
      border-radius: 16px;
      background: rgba(255,255,255,.92);
      box-shadow: 0 10px 24px rgba(42,46,70,.07);
    }

    .home-calendar-card {
      margin-top: 14px;
      padding: 22px;
      border-radius: 30px;
    }

    .home-card-head h2 {
      font-size: 1.46rem;
    }

    .home-calendar-track {
      gap: 12px;
      --home-day-width: 188px;
    }

    .home-day-card {
      min-height: 162px;
      border-radius: 22px;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.72);
    }

    .home-day-card.selected {
      transform: translateY(-1px);
    }

    .home-day-number {
      font-size: 1.9rem;
    }

    .home-dashboard-grid {
      grid-template-columns: 1.08fr 1.08fr 1.34fr;
      grid-template-areas:
        "agenda nutrition organizer"
        "gym music organizer";
      gap: 14px;
      margin-top: 16px;
      align-items: stretch;
    }

    .home-summary-card,
    .home-organizer-card,
    .home-music-card {
      border-radius: 26px;
      padding: 19px;
    }

    .home-summary-card.agenda { 
      grid-area: agenda; 
      min-height: 235px;
      box-shadow: 0 14px 32px rgba(79,85,123,.08);
    }
    .home-summary-card.nutrition { grid-area: nutrition; }
    .home-summary-card.gym { grid-area: gym; }
    .home-music-card { 
      grid-area: music; 
      min-height: 210px;
    }
    .home-organizer-card {
      grid-area: organizer;
      min-height: 460px;
      padding: 21px;
    }

    .home-summary-head h3,
    .home-organizer-head h3 {
      font-size: 1.12rem;
    }

    .home-card-kicker {
      font-size: .68rem;
      letter-spacing: .08em;
    }

    .home-summary-card .home-arrow {
      width: 30px;
      height: 30px;
      border-radius: 999px;
      display: inline-grid;
      place-items: center;
      background: rgba(255,255,255,.72);
      box-shadow: inset 0 0 0 1px rgba(30,30,40,.05);
    }

    .home-summary-card.agenda .home-arrow { box-shadow: inset 0 0 0 1px rgba(112,118,160,.14); }
    .home-summary-card.nutrition .home-arrow { box-shadow: inset 0 0 0 1px rgba(85,122,97,.14); }
    .home-summary-card.gym .home-arrow { box-shadow: inset 0 0 0 1px rgba(91,118,150,.14); }

    .home-summary-card::before,
    .home-organizer-card::before,
    .home-music-card::before {
      content: "";
      position: absolute;
      left: 0;
      top: 18px;
      bottom: 18px;
      width: 4px;
      border-radius: 0 999px 999px 0;
      opacity: .75;
    }

    .home-summary-card,
    .home-organizer-card,
    .home-music-card {
      position: relative;
      overflow: hidden;
    }

    .home-summary-card.agenda::before { background: linear-gradient(180deg, #9097c7, #7076a0); }
    .home-summary-card.nutrition::before { background: linear-gradient(180deg, #72957c, #557a61); }
    .home-summary-card.gym::before { background: linear-gradient(180deg, #7c94b0, #5b7696); }
    .home-music-card::before { background: linear-gradient(180deg, #b88dbf, #8f739d); }
    .home-organizer-card::before { background: linear-gradient(180deg, #999da9, #747985); }

    .home-meal-mini-list,
    .home-gym-mini-list {
      gap: 8px;
      margin-top: 16px;
    }

    .home-mini-row {
      padding: 9px 10px;
      border-radius: 12px;
      font-size: .74rem;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.75);
    }

    .home-summary-stat {
      margin-top: 12px;
      gap: 8px;
      flex-wrap: wrap;
    }

    .home-summary-stat span {
      padding: 6px 9px;
      border-radius: 10px;
      font-size: .63rem;
      letter-spacing: .02em;
    }

    #homeAgendaPreview .home-agenda-row {
      padding: 10px 11px;
      border-radius: 13px;
      margin-top: 8px;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.72);
    }

    .home-organizer-content {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 16px;
      height: calc(100% - 52px);
    }

    .home-todos {
      min-height: 0;
    }

    .home-todo-add {
      grid-template-columns: 1fr 36px;
      gap: 8px;
    }

    .home-todo-add input {
      padding: 11px 12px;
      border-radius: 14px;
    }

    .home-todo-add button {
      border-radius: 12px;
      font-weight: 800;
    }

    .home-todo-list {
      max-height: 160px;
      margin-top: 9px;
      gap: 7px;
    }

    .home-todo-item {
      padding: 8px 9px;
      border-radius: 12px;
      font-size: .73rem;
    }

    .home-note {
      min-height: 188px;
      border-radius: 16px;
      padding: 12px 13px;
      font-size: .76rem;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.72);
    }

    .music-now-playing {
      grid-template-columns: 62px minmax(0,1fr);
      gap: 12px;
      margin-top: 16px;
    }

    .music-artwork {
      width: 62px;
      height: 62px;
      border-radius: 16px;
      box-shadow: 0 8px 18px rgba(47,36,58,.08);
    }

    .music-controls {
      margin-top: 16px;
      gap: 9px;
    }

    .music-controls button {
      min-width: 40px;
      min-height: 40px;
      border-radius: 13px;
    }

    .music-connect-button {
      margin-top: 15px;
      border-radius: 14px;
      padding: 10px 12px;
    }

    .gym-shell,
    .nutrition-shell,
    .calendar-shell,
    .finance-shell {
      position: relative;
      overflow: hidden;
    }

    .gym-shell::before,
    .nutrition-shell::before,
    .calendar-shell::before,
    .finance-shell::before {
      content: "";
      position: absolute;
      inset: 0 0 auto 0;
      height: 5px;
      opacity: .9;
    }

    .finance-shell::before { background: linear-gradient(90deg, #c56e78 0%, #a6545d 55%, transparent 100%); }
    .gym-shell::before { background: linear-gradient(90deg, #85a0be 0%, #5b7696 55%, transparent 100%); }
    .nutrition-shell::before { background: linear-gradient(90deg, #7ea18a 0%, #557a61 55%, transparent 100%); }
    .calendar-shell::before { background: linear-gradient(90deg, #9499c1 0%, #7076a0 55%, transparent 100%); }

    .finance-heading h1,
    .gym-heading h1,
    .nutrition-heading h1,
    .calendar-heading h1 {
      font-size: clamp(2.2rem, 4.2vw, 3.45rem);
      letter-spacing: -.06em;
    }

    .dashboard-stat-strip > div,
    .nutrition-stat-strip > div,
    .gym-stat-strip > div {
      border-radius: 18px;
      min-height: 92px;
      padding: 16px 17px;
    }

    @media (max-width: 1200px) {
      .home-dashboard-grid {
        grid-template-columns: 1fr 1fr;
        grid-template-areas:
          "agenda nutrition"
          "gym music"
          "organizer organizer";
      }

      .home-organizer-card {
        min-height: 340px;
      }
    }



    /* ===== V15 Apple-clean refinement ===== */
    body {
      background: #f3f3f5;
    }

    .topbar {
      background: rgba(248,248,250,.82);
      border-color: rgba(20,20,25,.06);
      box-shadow: 0 1px 0 rgba(20,20,25,.035);
    }

    .tab.active,
    body.finance-active .tab.active,
    .tab.active[data-tab="finanzen"],
    .tab.active[data-tab="gym"],
    .tab.active[data-tab="ernaehrung"],
    .tab.active[data-tab="kalender"] {
      background: rgba(255,255,255,.96);
      color: #1d1d1f;
      box-shadow: 0 1px 5px rgba(20,20,25,.07);
    }

    .home-hero {
      background: rgba(255,255,255,.80);
      border: 1px solid rgba(20,20,25,.055);
      box-shadow: 0 8px 26px rgba(20,20,25,.045);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }

    .home-hero::after {
      color: rgba(29,29,31,.035);
    }

    .date-line { color: #74747a; }

    .home-settings-button {
      background: rgba(255,255,255,.88);
      border-color: rgba(20,20,25,.06);
      box-shadow: 0 3px 12px rgba(20,20,25,.05);
    }

    .home-calendar-card,
    .home-summary-card,
    .home-music-card,
    .home-organizer-card,
    .finance-shell,
    .gym-shell,
    .nutrition-shell,
    .calendar-shell {
      background: rgba(255,255,255,.78) !important;
      border-color: rgba(20,20,25,.055) !important;
      box-shadow: 0 10px 30px rgba(20,20,25,.045) !important;
    }

    .home-calendar-card,
    .home-summary-card,
    .home-music-card,
    .home-organizer-card {
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }

    .home-summary-card::before,
    .home-organizer-card::before,
    .home-music-card::before {
      top: 22px;
      bottom: 22px;
      width: 3px;
      opacity: .75;
      background: #c7c7cc;
    }

    .home-summary-card.agenda::before { background: var(--calendar-accent); }
    .home-summary-card.nutrition::before { background: var(--nutrition-accent); }
    .home-summary-card.gym::before { background: var(--gym-accent); }
    .home-music-card::before { background: #9a7ca2; }
    .home-organizer-card::before { background: #8e8e93; }

    .home-summary-card.agenda,
    .home-summary-card.nutrition,
    .home-summary-card.gym,
    .home-music-card,
    .home-organizer-card {
      background-image: none !important;
    }

    .home-summary-card:hover,
    .home-summary-card.agenda:hover,
    .home-summary-card.nutrition:hover,
    .home-summary-card.gym:hover,
    .home-music-card:hover,
    .home-organizer-card:hover,
    .home-calendar-card:hover {
      background: rgba(255,255,255,.94) !important;
      transform: translateY(-1px);
      filter: none;
      box-shadow: 0 12px 30px rgba(20,20,25,.06) !important;
    }

    .home-mini-row,
    .home-agenda-row,
    .home-todo-item,
    .home-note,
    .home-todo-add input {
      background: #f7f7f8;
      border-color: rgba(20,20,25,.055);
      box-shadow: none;
    }

    .home-day-card {
      background: #f7f7f8;
      border-color: rgba(20,20,25,.055);
      box-shadow: none;
    }

    .home-day-card:hover {
      background: #fbfbfc;
    }

    .home-day-card.selected {
      background: #f1f4f8;
      box-shadow: inset 0 0 0 1.5px rgba(91,118,150,.15);
    }

    .home-today-badge {
      background: #1d1d1f;
      color: white;
      box-shadow: none;
    }

    .home-summary-card .home-arrow {
      background: transparent;
      box-shadow: inset 0 0 0 1px rgba(20,20,25,.06) !important;
    }

    .music-artwork {
      background: #ececef;
      box-shadow: none;
    }

    .finance-shell::before,
    .gym-shell::before,
    .nutrition-shell::before,
    .calendar-shell::before {
      display: none;
    }

    .finance-shell,
    .gym-shell,
    .nutrition-shell,
    .calendar-shell {
      overflow: visible;
    }

    .finance-heading h1,
    .gym-heading h1,
    .nutrition-heading h1,
    .calendar-heading h1 {
      color: #1d1d1f;
    }

    .finance-eyebrow { color: var(--finance-accent); }
    .gym-eyebrow, .gym-kicker { color: var(--gym-accent); }
    .nutrition-eyebrow, .nutrition-kicker { color: var(--nutrition-accent); }
    .calendar-kicker { color: var(--calendar-accent); }

    .dashboard-stat-strip > div,
    .gym-calendar-card,
    .gym-workout-card,
    .gym-panel,
    .nutrition-day-rail,
    .nutrition-day-summary,
    .shopping-panel,
    .nutrition-meal-card,
    .nutrition-today-card,
    .nutrition-week-section,
    .calendar-month-panel,
    .calendar-agenda-panel,
    .calendar-apple-status,
    .balance-card,
    .money-panel {
      background: rgba(255,255,255,.74) !important;
      border-color: rgba(20,20,25,.055) !important;
      box-shadow: 0 6px 20px rgba(20,20,25,.035) !important;
    }

    .main-balance {
      background: #fbf6f7 !important;
      border-color: var(--finance-line) !important;
    }

    .gym-stat-strip > div:nth-child(1) {
      background: #f2f5f8 !important;
      border-color: rgba(91,118,150,.11) !important;
    }

    .nutrition-stat-strip > div:nth-child(1) {
      background: #f2f6f3 !important;
      border-color: rgba(85,122,97,.11) !important;
    }

    .calendar-day-cell.selected {
      background: #f2f3f7;
      box-shadow: inset 0 0 0 1.5px rgba(112,118,160,.13);
    }

    .gym-day-card.selected {
      background: #f2f5f8;
      box-shadow: inset 0 0 0 1.5px rgba(91,118,150,.14);
    }

    .nutrition-day-button.selected {
      background: #557a61;
      box-shadow: none;
    }

    .gym-primary-button,
    .nutrition-primary-button,
    .calendar-primary-button,
    .gym-add-exercise,
    .nutrition-add-meal,
    .meal-editor-save,
    .generator-save,
    .shopping-clear,
    .exercise-add-set,
    .exercise-editor-save {
      box-shadow: none;
    }

    .gym-primary-button { background: var(--gym-accent); }
    .nutrition-primary-button { background: var(--nutrition-accent); }
    .calendar-primary-button { background: var(--calendar-accent); }

    .gym-secondary-button,
    .nutrition-secondary-button,
    .calendar-secondary-button,
    .calendar-today-button,
    .soft-button,
    .edit-balance,
    .home-small-button {
      background: rgba(248,248,250,.92);
      border-color: rgba(20,20,25,.065);
      box-shadow: none;
    }

    .calendar-source.personal,
    .calendar-source.apple,
    .calendar-source.gym,
    .calendar-source.nutrition {
      border: 1px solid rgba(20,20,25,.04);
    }

    .dashboard-stat-strip > div {
      min-height: 82px;
    }
</style>
</head>
<body>
  <main class="app-shell">
    <header class="topbar">
      <button class="brand" id="homeButton" aria-label="Zur Startseite">
        <span class="brand-dot"></span>
        <span>Life Dashboard</span>
      </button>

      <div class="compact-datetime" id="compactDatetime"></div>

      <nav class="tabs">
        <button class="tab" data-tab="finanzen">Finanzen</button>
        <button class="tab" data-tab="gym">Gym</button>
        <button class="tab" data-tab="ernaehrung">Ernährung</button>
        <button class="tab" data-tab="kalender">Kalender</button>
        <button class="topbar-action-button" id="globalSearchButton" aria-label="Suchen">⌕</button>
        <button class="topbar-action-button quick" id="quickAddButton" aria-label="Schnell hinzufügen">＋</button>
        <button class="topbar-settings-button" id="homeSettingsButton" aria-label="Einstellungen">⚙︎</button>
      </nav>
    </header>

    <section id="homeView">
      <section class="home-hero">
        <div>
          <p class="eyebrow" id="greeting">Guten Tag</p>
          <h1 id="clock">--:--</h1>
          <p id="fullDate" class="date-line">Datum wird geladen …</p>
        </div>


      </section>

      <section class="home-calendar-card" id="homeCalendarCard">
        <div class="home-card-head">
          <div>
            <p class="eyebrow">Kalender</p>
            <h2>Deine Tage</h2>
          </div>

          <div class="home-calendar-actions">
            <button class="home-add-button" id="homeAddEvent" aria-label="Termin hinzufügen">＋</button>
          </div>
        </div>

        <div class="home-calendar-viewport" id="homeCalendarViewport">
          <div class="home-calendar-track" id="homeCalendarTrack"></div>
        </div>
      </section>

      <section class="home-dashboard-grid">
        <button class="home-summary-card agenda" id="homeAgendaCard">
          <div class="home-summary-head">
            <div>
              <span class="home-card-kicker" id="homeAgendaKicker">Heute</span>
              <h3>Agenda</h3>
            </div>
            <span class="home-arrow">→</span>
          </div>
          <div id="homeAgendaPreview"></div>
        </button>

        <button class="home-summary-card nutrition" data-home-open="ernaehrung">
          <div class="home-summary-head">
            <div>
              <span class="home-card-kicker">Ernährung</span>
              <h3>Heute</h3>
            </div>
            <span class="home-arrow">→</span>
          </div>
          <div id="homeNutritionPreview"></div>
        </button>

        <button class="home-summary-card gym" data-home-open="gym">
          <div class="home-summary-head">
            <div>
              <span class="home-card-kicker">Gym</span>
              <h3>Training</h3>
            </div>
            <span class="home-arrow">→</span>
          </div>
          <div id="homeGymPreview"></div>
        </button>

        <section class="home-music-card">
          <div class="home-summary-head">
            <div>
              <span class="home-card-kicker">Apple Music</span>
              <h3 id="musicCardTitle">Nicht verbunden</h3>
            </div>
            <span class="music-status-dot" id="musicStatusDot"></span>
          </div>

          <div class="music-now-playing">
            <div class="music-artwork" id="musicArtwork">♪</div>
            <div class="music-track-copy">
              <strong id="musicTrackName">Apple Music verbinden</strong>
              <span id="musicArtistName">MusicKit vorbereitet</span>
            </div>
          </div>

          <div class="music-controls">
            <button id="musicPrevious" aria-label="Zurück" disabled>‹‹</button>
            <button class="music-play-button" id="musicPlayPause" aria-label="Play/Pause" disabled>▶</button>
            <button id="musicNext" aria-label="Weiter" disabled>››</button>
          </div>

          <button class="music-connect-button" id="musicConnectButton">Verbinden</button>
        </section>

        <section class="home-organizer-card">
          <div class="home-organizer-head">
            <div>
              <span class="home-card-kicker">Organizer</span>
              <h3>To-Dos & Notizen</h3>
            </div>
          </div>

          <div class="home-organizer-content">
            <div class="home-todos">
              <div class="home-todo-add">
                <input id="homeTodoInput" type="text" placeholder="Neues To-Do …" />
                <button id="homeTodoAdd">＋</button>
              </div>
              <div id="homeTodoList" class="home-todo-list"></div>
            </div>

            <textarea id="homeNote" class="home-note" placeholder="Kurze Notiz …"></textarea>
          </div>
        </section>
      </section>
    </section>

    <section class="section-view hidden" id="financeView">
      <div class="finance-shell">
        <div class="finance-heading">
          <div>
            <p class="eyebrow finance-eyebrow">Finanzen</p>
            <h1>Monatsübersicht</h1>
            <p>Kontostand, Einnahmen und Ausgaben auf einen Blick.</p>
          </div>
          <button class="soft-button" id="resetFinance">Zurücksetzen</button>
        </div>

        <div class="finance-summary">
          <article class="balance-card main-balance" id="balanceCard">
            <div class="card-label-row">
              <span>Kontostand</span>
              <button class="edit-balance" id="editBalance">Bearbeiten</button>
            </div>
            <strong id="balanceValue">0,00 €</strong>
            <span class="subtle">Aktueller Stand</span>
          </article>
