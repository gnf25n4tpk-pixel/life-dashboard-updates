      .nutrition-print-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 18px;
        padding: 0 1mm 5mm;
        border-bottom: 1px solid #d9d9de;
      }

      .nutrition-print-header span {
        display: block;
        margin-bottom: 1.3mm;
        color: #7d7d83;
        font-size: 8pt;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .09em;
      }

      .nutrition-print-header h1 {
        margin: 0;
        font-size: 22pt;
        line-height: 1;
        letter-spacing: -.045em;
      }

      .nutrition-print-header strong {
        color: #67676d;
        font-size: 9pt;
        font-weight: 700;
      }

      .nutrition-print-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0,1fr));
        gap: 3.5mm;
        margin-top: 4.5mm;
      }


      .nutrition-print-grid.many-blocks {
        grid-template-columns: repeat(4, minmax(0,1fr));
        align-items: stretch;
      }

      .nutrition-print-grid.many-blocks .nutrition-print-block {
        min-height: 72mm;
      }
      .nutrition-print-block {
        min-width: 0;
        min-height: 151mm;
        box-sizing: border-box;
        border: 1px solid #dcdce1;
        border-radius: 4mm;
        padding: 4mm;
        break-inside: avoid;
        background: #fff;
      }

      .nutrition-print-block:nth-child(1) { border-top: 2.2mm solid #75977f; }
      .nutrition-print-block:nth-child(2) { border-top: 2.2mm solid #7188a7; }
      .nutrition-print-block:nth-child(3) { border-top: 2.2mm solid #a88967; }
      .nutrition-print-block:nth-child(4) { border-top: 2.2mm solid #8d789b; }

      .nutrition-print-block-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 8px;
        padding-bottom: 2.7mm;
        margin-bottom: 3.4mm;
        border-bottom: 1px solid #ececf0;
      }

      .nutrition-print-block-head strong {
        font-size: 12pt;
        letter-spacing: -.02em;
      }

      .nutrition-print-block-head span {
        color: #86868c;
        font-size: 7.5pt;
        font-weight: 700;
      }

      .nutrition-print-meal {
        padding-bottom: 3mm;
        margin-bottom: 3mm;
        border-bottom: 1px solid #f0f0f2;
      }

      .nutrition-print-meal:last-child {
        padding-bottom: 0;
        margin-bottom: 0;
        border-bottom: 0;
      }

      .nutrition-print-meal-label {
        color: #88888e;
        font-size: 6.8pt;
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: .065em;
      }

      .nutrition-print-meal-name {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 6px;
        margin-top: .9mm;
        font-size: 9pt;
        font-weight: 780;
      }

      .nutrition-print-meal-name > span:first-child {
        overflow-wrap: anywhere;
      }

      .nutrition-print-persons {
        flex: 0 0 auto;
        padding: .7mm 1.3mm;
        border-radius: 2mm;
        background: #edf5ef;
        color: #56715e;
        font-size: 6.5pt;
        font-weight: 800;
      }

      .nutrition-print-ingredients {
        margin: 1.6mm 0 0;
        padding: 0;
        list-style: none;
      }

      .nutrition-print-ingredients li {
        display: grid;
        grid-template-columns: minmax(0,1fr) auto;
        gap: 5px;
        align-items: baseline;
        margin-top: .75mm;
        color: #56565c;
        font-size: 7.1pt;
        line-height: 1.25;
      }

      .nutrition-print-ingredients li span {
        overflow-wrap: anywhere;
      }

      .nutrition-print-ingredients li strong {
        white-space: nowrap;
        color: #3f3f44;
      }

      .nutrition-print-empty {
        margin-top: 1mm;
        color: #aaaab0;
        font-size: 7.5pt;
      }

      .nutrition-print-footer {
        position: absolute;
        left: 1mm;
        right: 1mm;
        bottom: 0;
        padding-top: 2mm;
        border-top: 1px solid #eeeeF1;
        color: #99999f;
        font-size: 6.5pt;
      }

      /* Shopping page */
      .nutrition-print-shopping-page {
        padding-top: 0;
      }

      .nutrition-print-shopping-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 4mm;
        align-items: start;
        margin-top: 5mm;
      }

      .nutrition-print-shopping-group {
        break-inside: avoid;
        border: 1px solid #dcdce1;
        border-radius: 3.5mm;
        padding: 3.5mm;
      }

      .nutrition-print-shopping-group h2 {
        margin: 0 0 2.5mm;
        padding-bottom: 2mm;
        border-bottom: 1px solid #ececf0;
        color: #4b4b50;
        font-size: 10pt;
        letter-spacing: -.02em;
      }

      .nutrition-print-shopping-list {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .nutrition-print-shopping-item {
        display: grid;
        grid-template-columns: 4mm minmax(0,1fr) auto;
        gap: 2mm;
        align-items: center;
        padding: 1.3mm 0;
        border-bottom: 1px solid #f1f1f3;
        font-size: 7.6pt;
      }

      .nutrition-print-shopping-item:last-child {
        border-bottom: 0;
      }

      .nutrition-print-checkbox {
        width: 3mm;
        height: 3mm;
        box-sizing: border-box;
        border: 1px solid #96969c;
        border-radius: .6mm;
      }

      .nutrition-print-shopping-item span:nth-child(2) {
        overflow-wrap: anywhere;
      }

      .nutrition-print-shopping-item strong {
        white-space: nowrap;
        font-size: 7.4pt;
      }
    }


    /* ===== Vollständiger Kalender V24 ===== */
    .calendar-shell {
      padding: 30px;
      border-radius: 30px;
      background: rgba(255,255,255,.66);
      border: 1px solid rgba(255,255,255,.92);
      box-shadow: 0 18px 52px rgba(30,30,40,.06);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
    }

    .calendar-heading,
    .calendar-toolbar,
    .calendar-month-navigation,
    .calendar-heading-actions,
    .calendar-source-row {
      display: flex;
      align-items: center;
    }

    .calendar-heading {
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 22px;
    }

    .calendar-heading h1 {
      margin: 3px 0 5px;
      font-size: clamp(2rem,4vw,3.3rem);
      letter-spacing: -.055em;
    }

    .calendar-heading p {
      margin: 0;
      color: #7d7d83;
    }

    .calendar-heading-actions {
      gap: 8px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .calendar-primary-button,
    .calendar-secondary-button,
    .calendar-today-button {
      border-radius: 13px;
      padding: 9px 12px;
      cursor: pointer;
      font-weight: 750;
    }

    .calendar-primary-button {
      border: 0;
      background: #405b78;
      color: white;
    }

    .calendar-secondary-button,
    .calendar-today-button {
      border: 1px solid rgba(30,30,40,.07);
      background: #f1f1f3;
      color: #595960;
    }

    .calendar-toolbar {
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 11px;
    }

    .calendar-month-navigation {
      gap: 12px;
    }

    .calendar-month-navigation > button {
      width: 35px;
      height: 35px;
      border: 0;
      border-radius: 11px;
      background: #eeeeF1;
      color: #606067;
      cursor: pointer;
    }

    .calendar-month-navigation h2 {
      min-width: 180px;
      margin: 1px 0 0;
      font-size: 1.25rem;
      letter-spacing: -.035em;
    }

    .calendar-kicker {
      display: block;
      color: #939399;
      font-size: .62rem;
      font-weight: 850;
      text-transform: uppercase;
      letter-spacing: .065em;
    }

    .calendar-source-row {
      gap: 7px;
      flex-wrap: wrap;
      margin-bottom: 13px;
    }

    .calendar-source {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 8px;
      border-radius: 9px;
      font-size: .63rem;
      font-weight: 800;
    }

    .calendar-source::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
    }

    .calendar-source.personal { background: #edf5ef; color: #55715e; }
    .calendar-source.apple { background: #f7ecec; color: #9a6262; }
    .calendar-source.gym { background: #eaf0f8; color: #54708e; }
    .calendar-source.nutrition { background: #fff2e5; color: #9a6c37; }

    .calendar-layout {
      display: grid;
      grid-template-columns: minmax(0,1fr) 290px;
      gap: 13px;
      align-items: stretch;
    }

    .calendar-month-panel,
    .calendar-agenda-panel {
      border-radius: 23px;
      background: rgba(255,255,255,.78);
      border: 1px solid rgba(30,30,40,.055);
    }

    .calendar-month-panel {
      padding: 10px;
    }

    .calendar-weekdays,
    .calendar-month-grid {
      display: grid;
      grid-template-columns: repeat(7,minmax(0,1fr));
      gap: 5px;
    }

    .calendar-weekdays {
      padding: 0 2px 6px;
      color: #96969c;
      font-size: .61rem;
      font-weight: 850;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: .06em;
    }

    .calendar-day-cell {
      min-width: 0;
      min-height: 112px;
      padding: 8px;
      border: 1px solid rgba(30,30,40,.045);
      border-radius: 14px;
      background: #f8f8f9;
      cursor: pointer;
      position: relative;
      overflow: hidden;
      transition: .14s ease;
    }

    .calendar-day-cell:hover {
      background: white;
      transform: translateY(-1px);
    }

    .calendar-day-cell.outside {
      opacity: .43;
    }

    .calendar-day-cell.selected {
      background: #eef3f8;
      box-shadow: inset 0 0 0 2px rgba(69,94,124,.12);
    }

    .calendar-day-number {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 24px;
      height: 24px;
      border-radius: 8px;
      color: #5b5b61;
      font-size: .75rem;
      font-weight: 820;
    }

    .calendar-day-cell.today .calendar-day-number {
      background: #2f6a45;
      color: white;
    }

    .calendar-cell-events {
      display: flex;
      flex-direction: column;
      gap: 3px;
      margin-top: 5px;
    }

    .calendar-cell-event {
      min-width: 0;
      padding: 3px 5px;
      border-radius: 6px;
      font-size: .55rem;
      font-weight: 760;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .calendar-cell-event.personal { background: #edf5ef; color: #55715e; }
    .calendar-cell-event.apple { background: #f7ecec; color: #966060; }
    .calendar-cell-event.gym { background: #eaf0f8; color: #526d8b; }
    .calendar-cell-event.nutrition { background: #fff2e5; color: #936632; }

    .calendar-cell-more {
      padding-left: 3px;
      color: #98989e;
      font-size: .52rem;
      font-weight: 800;
    }

    .calendar-agenda-panel {
      padding: 17px;
      display: flex;
      flex-direction: column;
      min-height: 630px;
    }

    .calendar-agenda-head {
      padding-bottom: 13px;
      border-bottom: 1px solid rgba(30,30,40,.06);
    }

    .calendar-agenda-head h2 {
      margin: 3px 0 0;
      font-size: 1.25rem;
      letter-spacing: -.04em;
    }

    .calendar-agenda-list {
      display: flex;
      flex-direction: column;
      gap: 7px;
      padding: 12px 0;
      flex: 1;
    }

    .calendar-agenda-item {
      display: grid;
      grid-template-columns: 9px minmax(0,1fr);
      gap: 9px;
      padding: 9px 10px;
      border-radius: 13px;
      background: #f7f7f8;
    }

    .calendar-agenda-dot {
      width: 7px;
      height: 7px;
      margin-top: 5px;
      border-radius: 50%;
    }

    .calendar-agenda-dot.personal { background: #66836d; }
    .calendar-agenda-dot.apple { background: #ad6f6f; }
    .calendar-agenda-dot.gym { background: #5d7897; }
    .calendar-agenda-dot.nutrition { background: #b17b3e; }

    .calendar-agenda-main {
      min-width: 0;
    }

    .calendar-agenda-top {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      align-items: baseline;
    }

    .calendar-agenda-top strong {
      min-width: 0;
      color: #424247;
      font-size: .77rem;
      overflow-wrap: anywhere;
    }

    .calendar-agenda-top span {
      flex: 0 0 auto;
      color: #8e8e94;
      font-size: .64rem;
      font-weight: 750;
    }

    .calendar-agenda-sub {
      margin-top: 3px;
      color: #8e8e94;
      font-size: .64rem;
      line-height: 1.35;
    }

    .calendar-agenda-item.editable {
      cursor: pointer;
    }

    .calendar-agenda-item.editable:hover {
      background: #f0f5f1;
    }

    .calendar-empty-day {
      padding: 18px 3px;
      color: #99999f;
      font-size: .75rem;
      line-height: 1.45;
    }

    .calendar-apple-status {
      padding: 12px;
      border-radius: 14px;
      background: #f5f5f6;
      border: 1px solid rgba(30,30,40,.045);
    }

    .calendar-apple-status > div {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .calendar-apple-status strong {
      color: #54545a;
      font-size: .75rem;
    }

    .calendar-apple-status small {
      color: #95959b;
      font-size: .61rem;
      line-height: 1.35;
    }

    .calendar-clear-apple {
      margin-top: 9px;
      border: 0;
      background: transparent;
      color: #9b6060;
      padding: 0;
      font-size: .65rem;
      font-weight: 800;
      cursor: pointer;
    }

    @media (max-width: 1050px) {
      .calendar-layout {
        grid-template-columns: 1fr;
      }

      .calendar-agenda-panel {
        min-height: 0;
      }
    }

    @media (max-width: 760px) {
      .calendar-shell {
        padding: 18px;
      }

      .calendar-heading {
        align-items: flex-start;
        flex-direction: column;
      }

      .calendar-heading-actions {
        justify-content: flex-start;
      }

      .calendar-day-cell {
        min-height: 92px;
        padding: 6px;
      }

      .calendar-cell-event {
        font-size: .5rem;
      }
    }


    /* ===== V25 global actions ===== */
    .topbar-action-button {
      width: 38px;
      height: 38px;
      flex: 0 0 38px;
      border: 1px solid rgba(30,30,40,.07);
      border-radius: 12px;
      background: rgba(255,255,255,.76);
      color: #67676d;
      font-size: 1.08rem;
      cursor: pointer;
      transition: .16s ease;
    }

    .topbar-action-button.quick {
      background: #e8eff8;
      color: #486481;
      border-color: transparent;
    }

    .topbar-action-button:hover {
      transform: translateY(-1px);
      background: white;
    }

    .home-calendar-card {
      cursor: pointer;
    }

    .home-calendar-actions,
    .home-calendar-viewport {
      cursor: default;
    }

    .home-summary-card.agenda {
      background: rgba(255,255,255,.82);
    }

    .home-agenda-list {
      display: flex;
      flex-direction: column;
      gap: 7px;
      margin-top: 14px;
    }

    .home-agenda-row {
      display: grid;
      grid-template-columns: 46px 7px minmax(0,1fr);
      gap: 7px;
      align-items: center;
      padding: 7px 8px;
      border-radius: 11px;
      background: #f6f6f7;
      font-size: .69rem;
    }

    .home-agenda-time {
      color: #85858b;
      font-weight: 800;
    }

    .home-agenda-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
    }

    .home-agenda-dot.personal { background: #66836d; }
    .home-agenda-dot.apple { background: #ad6f6f; }
    .home-agenda-dot.gym { background: #5d7897; }
    .home-agenda-dot.nutrition { background: #b17b3e; }

    .home-agenda-row strong {
      min-width: 0;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    /* Apple Music */
    .home-music-card {
      min-height: 215px;
      border: 1px solid rgba(30,30,40,.055);
      border-radius: 24px;
      padding: 17px;
      background: rgba(255,255,255,.74);
      box-shadow: 0 10px 28px rgba(30,30,40,.045);
    }

    .music-status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #c7c7cc;
    }

    .music-status-dot.connected {
      background: #5c8a68;
      box-shadow: 0 0 0 4px rgba(92,138,104,.10);
    }

    .music-now-playing {
      display: grid;
      grid-template-columns: 54px minmax(0,1fr);
      gap: 11px;
      align-items: center;
      margin-top: 14px;
    }

    .music-artwork {
      width: 54px;
      height: 54px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      overflow: hidden;
      background: linear-gradient(145deg,#efeff2,#dedee4);
      color: #8d8d94;
      font-size: 1.35rem;
      font-weight: 800;
    }

    .music-artwork img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .music-track-copy {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .music-track-copy strong,
    .music-track-copy span {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .music-track-copy strong {
      color: #444449;
      font-size: .8rem;
    }

    .music-track-copy span {
      color: #909096;
      font-size: .67rem;
    }

    .music-controls {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 9px;
      margin-top: 13px;
    }

    .music-controls button {
      width: 35px;
      height: 35px;
      border: 0;
      border-radius: 50%;
      background: #f0f0f2;
      color: #55555b;
      cursor: pointer;
      font-size: .95rem;
    }

    .music-controls button:disabled {
      opacity: .38;
      cursor: default;
    }

    .music-controls .music-play-button {
      width: 40px;
      height: 40px;
      background: #343438;
      color: white;
      font-size: .78rem;
    }

    .music-connect-button {
      width: 100%;
      margin-top: 11px;
      border: 0;
      border-radius: 11px;
      padding: 8px 10px;
      background: #f1e8eb;
      color: #8b5662;
      font-size: .68rem;
      font-weight: 800;
      cursor: pointer;
    }

    .music-note {
      margin-top: 6px;
      color: #9a9aa0;
      font-size: .57rem;
      line-height: 1.35;
    }

    /* compact in-tab stats */
    .dashboard-stat-strip {
      display: grid;
      grid-template-columns: repeat(3,minmax(0,1fr));
      gap: 8px;
      margin: 0 0 12px;
    }

    .dashboard-stat-strip > div {
      padding: 11px 13px;
      border-radius: 15px;
      background: rgba(255,255,255,.62);
      border: 1px solid rgba(30,30,40,.05);
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .dashboard-stat-strip span {
      color: #929298;
      font-size: .61rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .045em;
    }

    .dashboard-stat-strip strong {
      color: #55555b;
      font-size: .78rem;
    }

    /* Settings */
    .settings-stack {
      display: flex;
      flex-direction: column;
      gap: 9px;
      margin-top: 18px;
    }

    .settings-card,
    .backup-card {
      padding: 14px;
      border-radius: 16px;
      background: #f5f6f7;
    }

    .settings-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .settings-card > div:first-child,
    .backup-card > div:first-child {
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 0;
    }

    .settings-card span,
    .backup-card span {
      color: #85858b;
      font-size: .7rem;
      line-height: 1.35;
    }

    .settings-inline-actions {
      display: flex;
      align-items: center;
      gap: 7px;
      flex-wrap: wrap;
    }

    .theme-toggle {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4px;
      padding: 4px;
      background: #e9e9ec;
      border-radius: 11px;
    }

    .theme-toggle button {
      border: 0;
      border-radius: 8px;
      padding: 7px 10px;
      background: transparent;
      color: #77777d;
      font-size: .67rem;
      font-weight: 800;
      cursor: pointer;
    }

    .theme-toggle button.active {
      background: white;
      color: #424247;
      box-shadow: 0 3px 8px rgba(30,30,40,.05);
    }

    .music-settings-card {
      align-items: stretch;
      flex-direction: column;
    }

    .settings-token-field {
      display: flex;
      flex-direction: column;
      gap: 5px;
      width: 100%;
    }

    .settings-token-field > span {
      color: #797980;
      font-size: .64rem;
      font-weight: 800;
    }

    .settings-token-field textarea {
      width: 100%;
      resize: vertical;
      border: 1px solid rgba(30,30,40,.08);
      border-radius: 11px;
      background: white;
      padding: 9px 10px;
      color: #444449;
      font: inherit;
      font-size: .68rem;
      outline: none;
    }

    /* Global search */
    .search-modal-card {
      width: min(620px,100%);
    }

