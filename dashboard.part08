          <div>
            <p class="eyebrow gym-eyebrow">Übung</p>
            <h2 id="exerciseEditorTitle">Übung bearbeiten</h2>
          </div>
          <button class="gym-editor-close" id="exerciseEditorClose" aria-label="Schließen">×</button>
        </div>

        <label class="exercise-name-field">
          <span>Name der Übung</span>
          <input type="text" id="exerciseEditorName" placeholder="z. B. Bankdrücken" />
        </label>

        <div class="exercise-sets-head">
          <div>
            <span class="gym-kicker">Sätze</span>
            <strong id="exerciseSetCount">0 Sätze</strong>
          </div>
          <button class="gym-secondary-button" id="exerciseAddSet">＋ Satz</button>
        </div>

        <div class="exercise-set-list" id="exerciseSetList"></div>

        <div class="exercise-history hidden" id="exerciseHistory">
          <div class="exercise-history-head">
            <span class="gym-kicker">Verlauf</span>
            <strong>Letzte Trainings</strong>
          </div>
          <div class="exercise-history-list" id="exerciseHistoryList"></div>
        </div>

        <div class="exercise-editor-actions">
          <button class="exercise-delete-button hidden" id="exerciseDelete">Übung löschen</button>
          <div class="exercise-editor-actions-right">
            <button class="gym-secondary-button" id="exerciseEditorCancel">Abbrechen</button>
            <button class="gym-primary-button" id="exerciseEditorSave">Speichern</button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal-backdrop" id="editModal" aria-hidden="true">
      <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <h3 id="modalTitle">Betrag bearbeiten</h3>
        <p id="modalText">Neuen Betrag eingeben.</p>
        <label class="modal-field">
          <span>€</span>
          <input id="modalInput" type="text" inputmode="decimal" autocomplete="off" />
        </label>
        <div class="modal-actions">
          <button class="modal-cancel" id="modalCancel">Abbrechen</button>
          <button class="modal-save" id="modalSave">Speichern</button>
        </div>
      </div>
    </div>

  <script>
    function playLaunchIntro() {
      if (!document.body.classList.contains("show-launch-intro")) return;
      const overlay = document.getElementById("launchIntro");
      const wordmark = document.getElementById("launchWordmark");
      const typed = document.getElementById("launchTyped");
      const word = "Dashboard";
      let index = 1;
      const finish = () => {
        overlay.remove();
        document.body.classList.remove("show-launch-intro");
        try { localStorage.setItem("lifeDashboardIntroV17", "seen"); } catch (_) {}
      };
      const typing = setInterval(() => {
        typed.textContent = word.slice(0, ++index);
        if (index < word.length) return;
        clearInterval(typing);
        setTimeout(() => {
          const from = wordmark.getBoundingClientRect();
          const to = document.getElementById("homeButton").getBoundingClientRect();
          wordmark.style.setProperty("--intro-x", `${to.left + to.width / 2 - from.left - from.width / 2}px`);
          wordmark.style.setProperty("--intro-y", `${to.top + to.height / 2 - from.top - from.height / 2}px`);
          wordmark.classList.add("to-header");
          setTimeout(() => overlay.classList.add("leaving"), 330);
          setTimeout(finish, 850);
        }, 240);
      }, 95);
    }
    playLaunchIntro();

    const tabs = document.querySelectorAll(".tab[data-tab]");
    const clock = document.getElementById("clock");
    const fullDate = document.getElementById("fullDate");
    const compactDatetime = document.getElementById("compactDatetime");
    const homeView = document.getElementById("homeView");
    const contentCard = document.getElementById("contentCard");
    const financeView = document.getElementById("financeView");
    const gymView = document.getElementById("gymView");
    const nutritionView = document.getElementById("nutritionView");
    const calendarView = document.getElementById("calendarView");
    const homeButton = document.getElementById("homeButton");
    const sectionTitle = document.getElementById("sectionTitle");
    const sectionText = document.getElementById("sectionText");

    const sectionCopy = {
      ernaehrung: ["Ernährung", "Hier kommt später dein Wochen-Essensplan mit Mahlzeiten und Lebensmitteln hin."]
    };

    const STORAGE_KEY = "lifeDashboardFinanceV5";
    const LEGACY_STORAGE_KEY = "lifeDashboardFinanceV3";
    const defaultFinance = { baseBalance: 0, subscriptions: [], shopping: [], other: [], income: [] };
    let finance = loadFinance();

    function cloneDefault() {
      return JSON.parse(JSON.stringify(defaultFinance));
    }

    function loadFinance() {
      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
        if (saved) return { ...cloneDefault(), ...saved };

        // Alte V4-Daten übernehmen, falls vorhanden.
        const legacy = JSON.parse(localStorage.getItem(LEGACY_STORAGE_KEY));
        if (legacy) {
          const migrated = {
            ...cloneDefault(),
            subscriptions: legacy.subscriptions || [],
            shopping: legacy.shopping || [],
            other: legacy.other || [],
            income: legacy.income || []
          };

          const oldExpenses =
            migrated.subscriptions.reduce((s, i) => s + Number(i.amount || 0), 0) +
            migrated.shopping.reduce((s, i) => s + Number(i.amount || 0), 0) +
            migrated.other.reduce((s, i) => s + Number(i.amount || 0), 0);

          const oldIncome =
            migrated.income.reduce((s, i) => s + Number(i.amount || 0), 0);

          migrated.baseBalance = Number(legacy.balance || 0) - oldIncome + oldExpenses;
          localStorage.setItem(STORAGE_KEY, JSON.stringify(migrated));
          return migrated;
        }

        return cloneDefault();
      } catch {
        return cloneDefault();
      }
    }

    function saveFinance() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(finance));
    }

    function euro(value) {
      return Number(value || 0).toLocaleString("de-DE", { style: "currency", currency: "EUR" });
    }

    function getGreeting(hour) {
      if (hour < 11) return "Guten Morgen";
      if (hour < 18) return "Guten Tag";
      return "Guten Abend";
    }

    function updateClock() {
      const now = new Date();
      clock.textContent = now.toLocaleTimeString("de-DE", { hour: "2-digit", minute: "2-digit" });
      fullDate.textContent = now.toLocaleDateString("de-DE", {
        weekday: "long", day: "2-digit", month: "long", year: "numeric"
      });

      const time = now.toLocaleTimeString("de-DE", { hour: "2-digit", minute: "2-digit" });
      const weekday = now.toLocaleDateString("de-DE", { weekday: "short" });
      const date = now.toLocaleDateString("de-DE", { day: "numeric", month: "short" });
      compactDatetime.textContent = `${time} · ${weekday} ${date}`;
      document.getElementById("greeting").textContent = getGreeting(now.getHours());
    }

    function startOfWeek(date) {
      const copy = new Date(date);
      const day = copy.getDay() || 7;
      copy.setHours(0,0,0,0);
      copy.setDate(copy.getDate() - day + 1);
      return copy;
    }

    function sameDate(a,b) {
      return a.getFullYear() === b.getFullYear() &&
             a.getMonth() === b.getMonth() &&
             a.getDate() === b.getDate();
    }

    function renderWeek() { renderHomeDashboard(); }

    function hideMainViews() {
      homeView.classList.add("hidden");
      contentCard.classList.add("hidden");
      financeView.classList.add("hidden");
      gymView.classList.add("hidden");
      nutritionView.classList.add("hidden");
      calendarView.classList.add("hidden");
    }

    const sectionScrollPositions = {
      home: 0,
      finanzen: 0,
      gym: 0,
      ernaehrung: 0,
      kalender: 0
    };

    let currentMainSection = "home";

    function saveCurrentScrollPosition() {
      sectionScrollPositions[currentMainSection] = window.scrollY;
    }

    function restoreSectionScroll(tabKey, mode = "preserve") {
      const target =
        mode === "top"
          ? 0
          : Number(sectionScrollPositions[tabKey] || 0);

      requestAnimationFrame(() => {
        window.scrollTo({
          top: target,
          behavior: "auto"
        });
      });
    }

    function openSection(tabKey, tabElement, options = {}) {
      const scrollMode = options.scrollMode || "preserve";

      saveCurrentScrollPosition();

      tabs.forEach(t => t.classList.remove("active"));
      if (tabElement) tabElement.classList.add("active");
      hideMainViews();
      compactDatetime.classList.add("visible");

      if (tabKey === "finanzen") {
        financeView.classList.remove("hidden");
        document.body.classList.add("finance-active");
        renderFinance();
      } else if (tabKey === "gym") {
        document.body.classList.remove("finance-active");
        gymView.classList.remove("hidden");
        renderGym();
        syncGymDayWidth();
        requestAnimationFrame(() => centerGymCalendarOnToday(false));
      } else if (tabKey === "ernaehrung") {
        document.body.classList.remove("finance-active");
        nutritionView.classList.remove("hidden");
        renderNutrition();
      } else if (tabKey === "kalender") {
        document.body.classList.remove("finance-active");
        calendarView.classList.remove("hidden");
        renderFullCalendar();
      } else {
        document.body.classList.remove("finance-active");
        const [title,text] = sectionCopy[tabKey];
        sectionTitle.textContent = title;
        sectionText.textContent = text;
        contentCard.classList.remove("hidden");
      }

      currentMainSection = tabKey;

      if (scrollMode === "top") {
        sectionScrollPositions[tabKey] = 0;
      }

      restoreSectionScroll(tabKey, scrollMode);
    }

    function goHome(options = {}) {
      const scrollMode = options.scrollMode || "preserve";

      saveCurrentScrollPosition();

      tabs.forEach(t => t.classList.remove("active"));
      hideMainViews();
      homeView.classList.remove("hidden");
      compactDatetime.classList.remove("visible");
      document.body.classList.remove("finance-active");

      currentMainSection = "home";
      renderHomeDashboard();
      requestAnimationFrame(() => centerHomeCalendarOnToday(false));

      restoreSectionScroll("home", scrollMode);
    }

    function totalFor(key) {
      return finance[key].reduce((sum,item) => sum + Number(item.amount || 0), 0);
    }

    function escapeHtml(text) {
      return String(text)
        .replaceAll("&","&amp;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;")
        .replaceAll('"',"&quot;")
        .replaceAll("'","&#039;");
    }


    const editModal = document.getElementById("editModal");
    const modalTitle = document.getElementById("modalTitle");
    const modalText = document.getElementById("modalText");
    const modalInput = document.getElementById("modalInput");
    const modalCancel = document.getElementById("modalCancel");
    const modalSave = document.getElementById("modalSave");

    let modalSaveHandler = null;

    function parseMoney(value) {
      const cleaned = String(value)
        .trim()
        .replace(/\s/g, "")
        .replace(/\./g, "")
        .replace(",", ".");
      const parsed = Number(cleaned);
      return Number.isFinite(parsed) ? parsed : null;
    }

    function openTextModal({ title, text, value = "", onSave }) {
      modalInput.closest(".modal-field")?.classList.add("text-mode");
      modalTitle.textContent = title;
      modalText.textContent = text;
      modalInput.value = value;
      modalInput.inputMode = "text";

      modalSaveHandler = () => {
        const parsed = modalInput.value.trim();
        if (!parsed) {
          modalInput.focus();
          modalInput.select();
          return;
        }
        onSave(parsed);
        closeAmountModal();
      };

      editModal.classList.add("open");
      editModal.setAttribute("aria-hidden", "false");
      setTimeout(() => {
        modalInput.focus();
        modalInput.select();
      }, 30);
    }

    function openAmountModal({ title, text, value, allowNegative = false, onSave }) {
      modalInput.closest(".modal-field")?.classList.remove("text-mode");
      modalTitle.textContent = title;
      modalText.textContent = text;
      modalInput.inputMode = "decimal";
      modalInput.value = Number(value || 0).toLocaleString("de-DE", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });

      modalSaveHandler = () => {
        const parsed = parseMoney(modalInput.value);
        if (parsed === null || (!allowNegative && parsed < 0)) {
          modalInput.focus();
          modalInput.select();
          return;
        }
        onSave(parsed);
        closeAmountModal();
      };

      editModal.classList.add("open");
      editModal.setAttribute("aria-hidden", "false");
      setTimeout(() => {
        modalInput.focus();
        modalInput.select();
      }, 30);
    }

    function closeAmountModal() {
      editModal.classList.remove("open");
      editModal.setAttribute("aria-hidden", "true");
      modalSaveHandler = null;
    }

    modalCancel.addEventListener("click", closeAmountModal);
    modalSave.addEventListener("click", () => modalSaveHandler?.());

    modalInput.addEventListener("keydown", event => {
      if (event.key === "Enter") modalSaveHandler?.();
      if (event.key === "Escape") closeAmountModal();
    });

    editModal.addEventListener("click", event => {
      if (event.target === editModal) closeAmountModal();
    });

    function renderList(key) {
      const list = document.getElementById(`list-${key}`);
      const entries = finance[key];
      list.innerHTML = "";

      if (!entries.length) {
        const empty = document.createElement("div");
        empty.className = "empty-state";
        empty.textContent = "Noch keine Einträge";
        list.appendChild(empty);
      } else {
