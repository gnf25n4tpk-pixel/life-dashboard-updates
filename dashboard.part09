        entries.forEach((entry,index) => {
          const row = document.createElement("div");
          row.className = "money-row";
          row.innerHTML = `
            <span class="name">${escapeHtml(entry.name)}</span>
            <span class="amount">${euro(entry.amount)}</span>
            <button class="edit-entry" data-edit="${key}" data-index="${index}" title="Betrag ändern">✎</button>
            <button class="delete-entry" data-delete="${key}" data-index="${index}" title="Eintrag löschen">×</button>
          `;
          list.appendChild(row);
        });
      }

      document.getElementById(`total-${key}`).textContent = euro(totalFor(key));
    }

    function currentBalance() {
      const expenses = totalFor("subscriptions") + totalFor("shopping") + totalFor("other");
      return Number(finance.baseBalance || 0) + totalFor("income") - expenses;
    }

    function renderFinance() {
      renderList("subscriptions");
      renderList("shopping");
      renderList("other");
      renderList("income");

      const income = totalFor("income");
      const expenses = totalFor("subscriptions") + totalFor("shopping") + totalFor("other");
      const balance = currentBalance();

      document.getElementById("balanceValue").textContent = euro(balance);
      document.getElementById("incomeTotal").textContent = euro(income);
      document.getElementById("expenseTotal").textContent = euro(expenses);

      const balanceCard = document.getElementById("balanceCard");
      const incomeCard = document.getElementById("incomeCard");
      const expenseCard = document.getElementById("expenseCard");

      balanceCard.classList.toggle("positive-balance", balance >= 0);
      balanceCard.classList.toggle("negative-balance", balance < 0);

      incomeCard.classList.toggle("income-leading", income > expenses);
      expenseCard.classList.toggle("expense-leading", expenses > income);
    }


    const GYM_STORAGE_KEY = "lifeDashboardGymV1";

    function gymClone(value) {
      return JSON.parse(JSON.stringify(value));
    }

    function makeIsoDate(date) {
      const y = date.getFullYear();
      const m = String(date.getMonth() + 1).padStart(2, "0");
      const d = String(date.getDate()).padStart(2, "0");
      return `${y}-${m}-${d}`;
    }

    const todayForGym = new Date();
    todayForGym.setHours(0,0,0,0);

    function makeGymDay(name) {
      return {
        id: `day-${Date.now()}-${Math.random().toString(36).slice(2,8)}`,
        name,
        exercises: []
      };
    }

    const defaultGym = {
      activeProfileId: "default",
      profiles: [
        {
          id: "default",
          name: "Mein Plan",
          startDate: makeIsoDate(todayForGym),
          loop: [
            makeGymDay("Push"),
            makeGymDay("Pull"),
            makeGymDay("Leg"),
            makeGymDay("Rest"),
            makeGymDay("Push"),
            makeGymDay("Pull"),
            makeGymDay("Rest")
          ]
        }
      ]
    };

    let gymData = loadGymData();
    let selectedGymDate = new Date(todayForGym);

    function workoutKey(name) {
      return String(name || "Training").trim().toLocaleLowerCase("de-DE");
    }

    function ensureProfileWorkoutData(profile) {
      if (!profile.templates || typeof profile.templates !== "object") profile.templates = {};
      if (!profile.logs || typeof profile.logs !== "object") profile.logs = {};

      profile.loop.forEach(day => {
        const key = workoutKey(day.name);

        if (!profile.templates[key]) {
          const migratedExercises = Array.isArray(day.exercises)
            ? day.exercises.map(exercise => ({
                id: exercise.id || `ex-${Date.now()}-${Math.random().toString(36).slice(2,8)}`,
                name: exercise.name || "Übung",
                setCount: Array.isArray(exercise.sets) && exercise.sets.length ? exercise.sets.length : 3
              }))
            : [];

          profile.templates[key] = {
            name: day.name,
            exercises: migratedExercises
          };
        }
      });

      return profile;
    }

    function normalizeGymData(data) {
      if (!data || !Array.isArray(data.profiles)) return gymClone(defaultGym);

      data.profiles.forEach(profile => {
        if (!Array.isArray(profile.loop)) profile.loop = [];

        profile.loop = profile.loop.map(item => {
          if (typeof item === "string") return makeGymDay(item);

          return {
            id: item.id || `day-${Date.now()}-${Math.random().toString(36).slice(2,8)}`,
            name: item.name || "Training",
            exercises: Array.isArray(item.exercises) ? item.exercises : []
          };
        });

        ensureProfileWorkoutData(profile);

        // Alte gespeicherte Logs auf das neue Format bringen.
        Object.values(profile.logs).forEach(log => {
          if (!log || typeof log !== "object") return;
          if (!log.exercises || typeof log.exercises !== "object") log.exercises = {};

          Object.values(log.exercises).forEach(ex => {
            if (!Array.isArray(ex.sets)) ex.sets = [];
            ex.sets = ex.sets.map(set => ({
              weight: Number(set.weight || 0),
              reps: Number(set.reps || 0)
            }));
          });
        });
      });

      return data;
    }

    function loadGymData() {
      try {
        const saved = JSON.parse(localStorage.getItem(GYM_STORAGE_KEY));
        if (saved && Array.isArray(saved.profiles) && saved.profiles.length) {
          const normalized = normalizeGymData(saved);
          localStorage.setItem(GYM_STORAGE_KEY, JSON.stringify(normalized));
          return normalized;
        }
      } catch {}
      return gymClone(defaultGym);
    }

    function saveGymData() {
      localStorage.setItem(GYM_STORAGE_KEY, JSON.stringify(gymData));
    }

    function activeGymProfile() {
      return gymData.profiles.find(p => p.id === gymData.activeProfileId) || gymData.profiles[0];
    }

    function parseIsoLocal(value) {
      const [y,m,d] = value.split("-").map(Number);
      return new Date(y, m - 1, d);
    }

    function dayDifference(a, b) {
      const one = new Date(a.getFullYear(), a.getMonth(), a.getDate());
      const two = new Date(b.getFullYear(), b.getMonth(), b.getDate());
      return Math.round((one - two) / 86400000);
    }

    function mod(n, m) {
      return ((n % m) + m) % m;
    }

    function gymSessionForDate(date) {
      const profile = activeGymProfile();
      if (!profile || !profile.loop.length) {
        return { name: "Kein Plan", index: -1, day: null };
      }

      const start = parseIsoLocal(profile.startDate);
      const offset = dayDifference(date, start);
      const index = mod(offset, profile.loop.length);
      const day = profile.loop[index];

      return {
        name: day?.name || `Tag ${index + 1}`,
        index,
        day
      };
    }


    function activeWorkoutTemplate(session = gymSessionForDate(selectedGymDate)) {
      const profile = activeGymProfile();
      if (!profile || !session?.day) return null;

      ensureProfileWorkoutData(profile);
      const key = workoutKey(session.name);

      if (!profile.templates[key]) {
        profile.templates[key] = { name: session.name, exercises: [] };
      }

      return profile.templates[key];
    }

    function workoutLogForDate(date, create = false) {
      const profile = activeGymProfile();
      if (!profile) return null;

      ensureProfileWorkoutData(profile);
      const iso = makeIsoDate(date);

      if (!profile.logs[iso] && create) {
        profile.logs[iso] = {
          workoutKey: workoutKey(gymSessionForDate(date).name),
          exercises: {}
        };
      }

      return profile.logs[iso] || null;
    }

    function previousWorkoutOccurrence(date, sessionName) {
      const profile = activeGymProfile();
      if (!profile) return null;

      const targetKey = workoutKey(sessionName);
      const probe = new Date(date);
      const maxLookback = Math.max(120, profile.loop.length * 20);

      for (let i = 1; i <= maxLookback; i++) {
        probe.setDate(probe.getDate() - 1);

        if (workoutKey(gymSessionForDate(probe).name) !== targetKey) continue;

        const log = workoutLogForDate(probe, false);
        if (log && log.workoutKey === targetKey) {
          return { date: new Date(probe), log };
        }
      }

      return null;
    }

    function latestLoggedWorkoutDate(sessionName) {
      const profile = activeGymProfile();
      if (!profile) return null;

      const targetKey = workoutKey(sessionName);
      const dates = Object.keys(profile.logs || {})
        .filter(iso => profile.logs[iso]?.workoutKey === targetKey)
        .sort();

      return dates.length ? parseIsoLocal(dates[dates.length - 1]) : null;
    }

    function nextOccurrenceAfter(date, sessionName) {
      const profile = activeGymProfile();
      if (!profile) return null;

      const targetKey = workoutKey(sessionName);
      const probe = new Date(date);

      for (let i = 1; i <= Math.max(60, profile.loop.length * 4); i++) {
        probe.setDate(probe.getDate() + 1);
        if (workoutKey(gymSessionForDate(probe).name) === targetKey) {
          return new Date(probe);
        }
      }

      return null;
    }

    function shouldShowPreviousReference(date, sessionName) {
      const latest = latestLoggedWorkoutDate(sessionName);
      if (!latest) return false;

      const next = nextOccurrenceAfter(latest, sessionName);
      return next ? sameDate(next, date) : false;
    }

    const gymProfileSelect = document.getElementById("gymProfileSelect");
    const gymDaysViewport = document.getElementById("gymDaysViewport");
    const gymDaysTrack = document.getElementById("gymDaysTrack");
    const selectedGymDateLabel = document.getElementById("selectedGymDateLabel");
    const selectedGymDayTitle = document.getElementById("selectedGymDayTitle");
    const selectedSessionBadge = document.getElementById("selectedSessionBadge");

    const gymEditorModal = document.getElementById("gymEditorModal");
    const gymEditorName = document.getElementById("gymEditorName");
    const gymEditorStartDate = document.getElementById("gymEditorStartDate");
    const gymEditorLoop = document.getElementById("gymEditorLoop");
    const gymEditorLoopCount = document.getElementById("gymEditorLoopCount");
    const gymEditorDeletePlan = document.getElementById("gymEditorDeletePlan");

    let gymEditorDraft = null;
    let gymEditorIsNew = false;

    function renderGymProfileSelect() {
      gymProfileSelect.innerHTML = "";

      gymData.profiles.forEach(profile => {
        const option = document.createElement("option");
        option.value = profile.id;
        option.textContent = profile.name;
        option.selected = profile.id === gymData.activeProfileId;
        gymProfileSelect.appendChild(option);
      });
    }

    function renderGymCalendar() {
      const rangeBefore = 30;
      const rangeAfter = 30;
      gymDaysTrack.innerHTML = "";

      for (let i = -rangeBefore; i <= rangeAfter; i++) {
        const date = new Date(todayForGym);
        date.setDate(todayForGym.getDate() + i);

        const session = gymSessionForDate(date);
        const card = document.createElement("button");
        card.className = "gym-day-card";
        card.type = "button";
        card.dataset.gymDate = makeIsoDate(date);

        if (sameDate(date, todayForGym)) card.classList.add("today");
        if (sameDate(date, selectedGymDate)) card.classList.add("selected");

        card.innerHTML = `
          ${sameDate(date, todayForGym) ? `<span class="gym-today-badge">Heute</span>` : ""}
          <div class="gym-day-top">
            <div class="gym-day-date-stack">
              <div class="gym-day-name">${date.toLocaleDateString("de-DE",{weekday:"short"})}</div>
              <div class="gym-day-number">${date.getDate()}</div>
              <div class="gym-day-index">${date.toLocaleDateString("de-DE",{month:"short"})}</div>
            </div>
          </div>
          <div>
            <div class="gym-session-name">${escapeHtml(session.name)}</div>
            ${sameDate(date, selectedGymDate) ? `<div class="gym-selected-label">Ausgewählt</div>` : ""}
          </div>
        `;

        gymDaysTrack.appendChild(card);
      }
    }

    function renderSelectedGymDay() {
      const session = gymSessionForDate(selectedGymDate);

      selectedGymDateLabel.textContent = sameDate(selectedGymDate, todayForGym)
        ? "Heute"
        : selectedGymDate.toLocaleDateString("de-DE", {
            weekday: "short", day: "2-digit", month: "short"
          });

      selectedGymDayTitle.textContent = session.name;
      selectedSessionBadge.textContent = session.index >= 0
        ? `Tag ${session.index + 1}`
        : "–";

      renderGymExercises(session);
    }

    function renderGymExercises(session) {
      const list = document.getElementById("gymExerciseList");
      list.innerHTML = "";

      const template = activeWorkoutTemplate(session);
      const exercises = template?.exercises || [];
      const currentLog = workoutLogForDate(selectedGymDate, false);
      const previous = previousWorkoutOccurrence(selectedGymDate, session.name);
      const showReference = shouldShowPreviousReference(selectedGymDate, session.name);

      if (!exercises.length) {
        list.innerHTML = `<div class="gym-empty-workout">Noch keine Übungen hinterlegt.</div>`;
        return;
      }

      exercises.forEach((exercise, index) => {
        const card = document.createElement("button");
        card.type = "button";
        card.className = "gym-exercise-card";
        card.dataset.exerciseIndex = index;

        const currentSets = currentLog?.exercises?.[exercise.id]?.sets || null;
        const previousSets = previous?.log?.exercises?.[exercise.id]?.sets || null;

        let displaySets = null;
        let chipClass = "";
        let note = "";

        if (currentSets?.length) {
          displaySets = currentSets;
          chipClass = "current";
          note = "Aktuell eingetragen";
        } else if (showReference && previousSets?.length) {
          displaySets = previousSets;
          chipClass = "reference";
          note = `Letztes Mal · ${previous.date.toLocaleDateString("de-DE",{day:"2-digit",month:"2-digit"})}`;
        }

        const chips = displaySets?.length
          ? displaySets.map(set => `
              <span class="gym-weight-chip ${chipClass}">
                <span class="chip-weight">${Number(set.weight || 0).toLocaleString("de-DE")} kg</span>
                <span class="chip-separator">·</span>
                <span class="chip-reps">${Number(set.reps || 0)} Wdh.</span>
              </span>
            `).join("")
          : `<span class="gym-weight-chip">${exercise.setCount} ${exercise.setCount === 1 ? "Satz" : "Sätze"}</span>`;

        card.innerHTML = `
          <div>
            <span class="gym-exercise-name">${escapeHtml(exercise.name)}</span>
            <div class="gym-exercise-meta">${exercise.setCount} ${exercise.setCount === 1 ? "Satz" : "Sätze"}</div>
            ${note ? `<div class="gym-last-time">${note}</div>` : ""}
          </div>
          <div class="gym-exercise-weights">${chips}</div>
        `;

        list.appendChild(card);
      });
    }


    function renderGymStats() {
      const profile = activeGymProfile();
      if (!profile) return;

      const monday = startOfWeek(todayForGym);
      const sunday = new Date(monday);
      sunday.setDate(monday.getDate() + 6);

      let sessions = 0;
      let sets = 0;

      Object.entries(profile.logs || {}).forEach(([iso, log]) => {
        const date = parseIsoLocal(iso);
        if (date < monday || date > sunday) return;

        const exerciseLogs = Object.values(log.exercises || {});
        if (exerciseLogs.length) sessions++;
        exerciseLogs.forEach(exercise => {
          sets += (exercise.sets || []).filter(set =>
            Number(set.weight || 0) > 0 || Number(set.reps || 0) > 0
          ).length;
        });
      });

      const lastIso = Object.entries(profile.logs || {})
        .filter(([, log]) => Object.keys(log.exercises || {}).length)
        .map(([iso]) => iso)
        .sort()
        .pop();

      document.getElementById("gymWeekSessions").textContent =
        `${sessions} ${sessions === 1 ? "Training" : "Trainings"}`;
      document.getElementById("gymWeekSets").textContent = `${sets} Sätze`;
      document.getElementById("gymLastLogged").textContent =
        lastIso ? parseIsoLocal(lastIso).toLocaleDateString("de-DE",{day:"2-digit",month:"2-digit"}) : "–";
    }

    function renderGym() {
      renderGymProfileSelect();
      renderGymStats();
      renderGymCalendar();
      renderSelectedGymDay();
    }

    function centerGymCalendarOnToday(smooth = true) {
      const todayCard = gymDaysTrack.querySelector(".gym-day-card.today");
      if (!todayCard) return;

      const targetLeft =
        todayCard.offsetLeft -
        gymDaysViewport.clientWidth / 2 +
        todayCard.clientWidth / 2;

      gymDaysViewport.scrollTo({
        left: targetLeft,
        behavior: smooth ? "smooth" : "auto"
      });
    }

    function syncGymDayWidth() {
      if (window.innerWidth <= 900) {
        gymDaysTrack.style.removeProperty("--gym-day-width");
        return;
      }

      const gap = 10;
      const visibleCards = 5;
      const width = Math.max(
        150,
        (gymDaysViewport.clientWidth - gap * (visibleCards - 1)) / visibleCards
      );

      gymDaysTrack.style.setProperty("--gym-day-width", `${width}px`);
    }

    function renderGymEditorLoop() {
      gymEditorLoop.innerHTML = "";

      gymEditorDraft.loop.forEach((day, index) => {
        const row = document.createElement("div");
        row.className = "gym-editor-row";
        row.innerHTML = `
          <span class="gym-editor-index">${index + 1}</span>
          <input type="text" value="${escapeHtml(day.name)}" data-gym-editor-name="${index}" />
          <button title="Nach oben" data-gym-editor-up="${index}">↑</button>
          <button title="Nach unten" data-gym-editor-down="${index}">↓</button>
          <button title="Löschen" data-gym-editor-delete="${index}">×</button>
        `;
        gymEditorLoop.appendChild(row);
      });

      if (!gymEditorDraft.loop.length) {
        gymEditorLoop.innerHTML = `<div class="empty-state">Keine Tage im Loop.</div>`;
      }

      gymEditorLoopCount.textContent =
        `${gymEditorDraft.loop.length} ${gymEditorDraft.loop.length === 1 ? "Tag" : "Tage"}`;
    }

    function openGymEditor(asNew = false) {
      gymEditorIsNew = asNew;

      if (asNew) {
        gymEditorDraft = {
          id: `gym-${Date.now()}`,
          name: `Plan ${gymData.profiles.length + 1}`,
          startDate: makeIsoDate(todayForGym),
          loop: [makeGymDay("Push"), makeGymDay("Pull"), makeGymDay("Leg"), makeGymDay("Rest")]
        };
      } else {
        gymEditorDraft = gymClone(activeGymProfile());
      }

      gymEditorName.value = gymEditorDraft.name;
      gymEditorStartDate.value = gymEditorDraft.startDate;
      gymEditorDeletePlan.hidden = asNew;
      gymEditorDeletePlan.disabled = gymData.profiles.length <= 1;
      gymEditorDeletePlan.title = gymEditorDeletePlan.disabled
        ? "Der letzte Trainingsplan kann nicht gelöscht werden"
        : "Löscht diesen Plan mit seinen Trainingsdaten";
      gymEditorDeletePlan.dataset.confirm = "";
      gymEditorDeletePlan.textContent = "Plan löschen";
      renderGymEditorLoop();

      gymEditorModal.classList.add("open");
      gymEditorModal.setAttribute("aria-hidden", "false");
    }

    function closeGymEditor() {
      gymEditorModal.classList.remove("open");
      gymEditorModal.setAttribute("aria-hidden", "true");
      gymEditorDraft = null;
      gymEditorIsNew = false;
    }

    function saveGymEditor() {
      const name = gymEditorName.value.trim();
      const startDate = gymEditorStartDate.value;

      if (!name || !startDate || !gymEditorDraft.loop.length) return;

      gymEditorDraft.name = name;
      gymEditorDraft.startDate = startDate;

      if (gymEditorIsNew) {
        gymData.profiles.push(gymClone(gymEditorDraft));
        gymData.activeProfileId = gymEditorDraft.id;
      } else {
        const index = gymData.profiles.findIndex(p => p.id === gymEditorDraft.id);
        if (index >= 0) gymData.profiles[index] = gymClone(gymEditorDraft);
      }

      ensureProfileWorkoutData(activeGymProfile());
      saveGymData();
      closeGymEditor();
      renderGym();
      syncGymDayWidth();
      requestAnimationFrame(() => centerGymCalendarOnToday(false));
    }

    function deleteGymProfile() {
      if (gymEditorIsNew || !gymEditorDraft || gymData.profiles.length <= 1) return;
      if (gymEditorDeletePlan.dataset.confirm !== gymEditorDraft.id) {
        const profileId = gymEditorDraft.id;
        gymEditorDeletePlan.dataset.confirm = profileId;
        gymEditorDeletePlan.textContent = "Wirklich löschen?";
        setTimeout(() => {
          if (gymEditorDeletePlan.dataset.confirm !== profileId) return;
          gymEditorDeletePlan.dataset.confirm = "";
          gymEditorDeletePlan.textContent = "Plan löschen";
        }, 5000);
        return;
      }

      gymData.profiles = gymData.profiles.filter(profile => profile.id !== gymEditorDraft.id);
      gymData.activeProfileId = gymData.profiles[0].id;
      selectedGymDate = new Date(todayForGym);
      saveGymData();
      closeGymEditor();
      renderGym();
      syncGymDayWidth();
      requestAnimationFrame(() => centerGymCalendarOnToday(false));
    }


    const exerciseEditorModal = document.getElementById("exerciseEditorModal");
    const exerciseEditorName = document.getElementById("exerciseEditorName");
    const exerciseSetList = document.getElementById("exerciseSetList");
    const exerciseSetCount = document.getElementById("exerciseSetCount");
    const exerciseDelete = document.getElementById("exerciseDelete");

    let exerciseEditorDraft = null;
    let exerciseEditorIndex = null;

    function selectedGymSession() {
      return gymSessionForDate(selectedGymDate);
    }

    function renderExerciseSetEditor() {
      exerciseSetList.innerHTML = "";

      exerciseEditorDraft.sets.forEach((set, index) => {
        const row = document.createElement("div");
        row.className = "exercise-set-row";
        row.innerHTML = `
          <span class="exercise-set-number">${index + 1}</span>
          <label class="exercise-weight-input">
            <input type="number" min="0" step="0.5" value="${Number(set.weight || 0)}" data-exercise-weight="${index}" />
            <span>kg</span>
          </label>
          <label class="exercise-reps-input">
            <input type="number" min="0" step="1" value="${Number(set.reps || 0)}" data-exercise-reps="${index}" />
            <span>Wdh.</span>
          </label>
          <button class="exercise-set-delete" data-exercise-set-delete="${index}" title="Satz löschen">×</button>
        `;
        exerciseSetList.appendChild(row);
      });

      if (!exerciseEditorDraft.sets.length) {
        exerciseSetList.innerHTML = `<div class="empty-state">Noch keine Sätze angelegt.</div>`;
      }

      exerciseSetCount.textContent =
        `${exerciseEditorDraft.sets.length} ${exerciseEditorDraft.sets.length === 1 ? "Satz" : "Sätze"}`;
    }

    function valuesForExerciseOnSelectedDate(exercise) {
      const session = selectedGymSession();
      const currentLog = workoutLogForDate(selectedGymDate, false);
      const current = currentLog?.exercises?.[exercise.id]?.sets;

      if (current?.length) return gymClone(current);

      const previous = previousWorkoutOccurrence(selectedGymDate, session.name);
      const showReference = shouldShowPreviousReference(selectedGymDate, session.name);
      const prior = previous?.log?.exercises?.[exercise.id]?.sets;

      if (showReference && prior?.length) return gymClone(prior);

      return Array.from({ length: exercise.setCount || 3 }, () => ({ weight: 0, reps: 0 }));
    }


    function exerciseHistoryEntries(exerciseId) {
      const profile = activeGymProfile();
      if (!profile) return [];

      const selectedIso = makeIsoDate(selectedGymDate);

      return Object.entries(profile.logs || {})
        .filter(([iso, log]) =>
          iso !== selectedIso &&
          Array.isArray(log?.exercises?.[exerciseId]?.sets) &&
          log.exercises[exerciseId].sets.length
        )
        .sort((a,b) => b[0].localeCompare(a[0]))
        .slice(0,4)
        .map(([iso, log]) => ({
          date: parseIsoLocal(iso),
          sets: log.exercises[exerciseId].sets
        }));
    }

    function renderExerciseHistory(exerciseId = null) {
      const box = document.getElementById("exerciseHistory");
      const list = document.getElementById("exerciseHistoryList");
      if (!box || !list || !exerciseId) {
        box?.classList.add("hidden");
        return;
      }

      const entries = exerciseHistoryEntries(exerciseId);

      if (!entries.length) {
        box.classList.add("hidden");
        list.innerHTML = "";
        return;
      }

      box.classList.remove("hidden");
      list.innerHTML = entries.map(entry => `
        <div class="exercise-history-row">
          <span class="exercise-history-date">${entry.date.toLocaleDateString("de-DE",{day:"2-digit",month:"2-digit"})}</span>
          <div class="exercise-history-sets">
            ${entry.sets.map(set => `
              <span class="exercise-history-chip">${Number(set.weight || 0).toLocaleString("de-DE")} kg × ${Number(set.reps || 0)}</span>
            `).join("")}
          </div>
        </div>
      `).join("");
    }

    function openExerciseEditor(index = null) {
      const session = selectedGymSession();
      const template = activeWorkoutTemplate(session);
      if (!session.day || !template) return;

      exerciseEditorIndex = index;

      if (index === null) {
        exerciseEditorDraft = {
          id: `ex-${Date.now()}-${Math.random().toString(36).slice(2,8)}`,
          name: "",
          sets: [
            { weight: 0, reps: 0 },
            { weight: 0, reps: 0 },
            { weight: 0, reps: 0 }
          ]
        };
        exerciseDelete.classList.add("hidden");
        renderExerciseHistory(null);
      } else {
        const exercise = template.exercises[index];
        exerciseEditorDraft = {
          id: exercise.id,
          name: exercise.name,
          sets: valuesForExerciseOnSelectedDate(exercise)
        };
        exerciseDelete.classList.remove("hidden");
        renderExerciseHistory(exercise.id);
      }

      exerciseEditorName.value = exerciseEditorDraft.name;
      renderExerciseSetEditor();

      exerciseEditorModal.classList.add("open");
      exerciseEditorModal.setAttribute("aria-hidden", "false");
      setTimeout(() => exerciseEditorName.focus(), 30);
    }

    function closeExerciseEditor() {
      exerciseEditorModal.classList.remove("open");
      exerciseEditorModal.setAttribute("aria-hidden", "true");
      exerciseEditorDraft = null;
      exerciseEditorIndex = null;
    }

    function saveExerciseEditor() {
      if (!exerciseEditorDraft) return;

      const name = exerciseEditorName.value.trim();
      const session = selectedGymSession();
      const template = activeWorkoutTemplate(session);
      if (!name || !session.day || !template) return;

      exerciseEditorDraft.name = name;

      let exerciseId;

      if (exerciseEditorIndex === null) {
        const definition = {
          id: exerciseEditorDraft.id,
          name,
          setCount: exerciseEditorDraft.sets.length
        };
        template.exercises.push(definition);
        exerciseId = definition.id;
      } else {
        const definition = template.exercises[exerciseEditorIndex];
        definition.name = name;
        definition.setCount = exerciseEditorDraft.sets.length;
        exerciseId = definition.id;
      }

      const log = workoutLogForDate(selectedGymDate, true);
      log.workoutKey = workoutKey(session.name);
      log.exercises[exerciseId] = {
        sets: exerciseEditorDraft.sets.map(set => ({
          weight: Number(set.weight || 0),
          reps: Number(set.reps || 0)
        }))
      };

      saveGymData();
      closeExerciseEditor();
      renderSelectedGymDay();
    }

    document.getElementById("gymAddExercise").addEventListener("click", () => openExerciseEditor(null));

    document.getElementById("gymExerciseList").addEventListener("click", event => {
      const card = event.target.closest("[data-exercise-index]");
      if (!card) return;
      openExerciseEditor(Number(card.dataset.exerciseIndex));
    });

    document.getElementById("exerciseAddSet").addEventListener("click", () => {
      if (!exerciseEditorDraft) return;

      const last = exerciseEditorDraft.sets.length
        ? exerciseEditorDraft.sets[exerciseEditorDraft.sets.length - 1]
        : { weight: 0, reps: 0 };

      exerciseEditorDraft.sets.push({
        weight: Number(last.weight || 0),
        reps: Number(last.reps || 0)
      });

      renderExerciseSetEditor();
    });

    exerciseSetList.addEventListener("input", event => {
      if (!exerciseEditorDraft) return;

      const weightInput = event.target.closest("[data-exercise-weight]");
      if (weightInput) {
        const index = Number(weightInput.dataset.exerciseWeight);
        const value = Number(weightInput.value);
        exerciseEditorDraft.sets[index].weight = Number.isFinite(value) ? value : 0;
        return;
      }

      const repsInput = event.target.closest("[data-exercise-reps]");
      if (repsInput) {
        const index = Number(repsInput.dataset.exerciseReps);
        const value = Number(repsInput.value);
        exerciseEditorDraft.sets[index].reps = Number.isFinite(value) ? value : 0;
      }
    });

    exerciseSetList.addEventListener("click", event => {
      const button = event.target.closest("[data-exercise-set-delete]");
      if (!button || !exerciseEditorDraft) return;

      const index = Number(button.dataset.exerciseSetDelete);
      exerciseEditorDraft.sets.splice(index, 1);
      renderExerciseSetEditor();
    });

    document.getElementById("exerciseEditorSave").addEventListener("click", saveExerciseEditor);
    document.getElementById("exerciseEditorCancel").addEventListener("click", closeExerciseEditor);
    document.getElementById("exerciseEditorClose").addEventListener("click", closeExerciseEditor);

    exerciseDelete.addEventListener("click", () => {
      if (exerciseEditorIndex === null) return;

      const session = selectedGymSession();
      const template = activeWorkoutTemplate(session);
      if (!template) return;

      const exercise = template.exercises[exerciseEditorIndex];
      template.exercises.splice(exerciseEditorIndex, 1);

      // Die Übungsdefinition wird für alle gleichnamigen Trainingstage entfernt.
      // Historische Tageswerte bleiben intern bestehen, werden aber nicht mehr angezeigt.
      saveGymData();
      closeExerciseEditor();
      renderSelectedGymDay();
    });

    exerciseEditorModal.addEventListener("click", event => {
      if (event.target === exerciseEditorModal) closeExerciseEditor();
    });

    window.addEventListener("resize", () => {
      syncGymDayWidth();
      if (!gymView.classList.contains("hidden")) {
        requestAnimationFrame(() => centerGymCalendarOnToday(false));
      }
    });

    gymProfileSelect.addEventListener("change", () => {
      gymData.activeProfileId = gymProfileSelect.value;
      saveGymData();
      selectedGymDate = new Date(todayForGym);
      renderGym();
      syncGymDayWidth();
      requestAnimationFrame(() => centerGymCalendarOnToday(false));
    });

    document.getElementById("gymTodayButton").addEventListener("click", () => {
      selectedGymDate = new Date(todayForGym);
      renderGymCalendar();
      renderSelectedGymDay();
      requestAnimationFrame(() => centerGymCalendarOnToday(true));
    });

    document.getElementById("editGymProfile").addEventListener("click", () => openGymEditor(false));
    document.getElementById("gymEditorNewPlan").addEventListener("click", () => openGymEditor(true));
    document.getElementById("gymEditorClose").addEventListener("click", closeGymEditor);
    document.getElementById("gymEditorCancel").addEventListener("click", closeGymEditor);
    document.getElementById("gymEditorSave").addEventListener("click", saveGymEditor);
    gymEditorDeletePlan.addEventListener("click", deleteGymProfile);

    document.getElementById("gymEditorAddDay").addEventListener("click", () => {
      if (!gymEditorDraft) return;
      gymEditorDraft.loop.push(makeGymDay(`Tag ${gymEditorDraft.loop.length + 1}`));
      renderGymEditorLoop();
    });

    gymEditorModal.addEventListener("click", event => {
      if (event.target === gymEditorModal) closeGymEditor();
    });

    gymEditorLoop.addEventListener("input", event => {
      const input = event.target.closest("[data-gym-editor-name]");
      if (!input || !gymEditorDraft) return;
      const index = Number(input.dataset.gymEditorName);
      gymEditorDraft.loop[index].name = input.value;
    });

    gymEditorLoop.addEventListener("click", event => {
      if (!gymEditorDraft) return;

      const up = event.target.closest("[data-gym-editor-up]");
      if (up) {
        const index = Number(up.dataset.gymEditorUp);
        if (index > 0) {
          [gymEditorDraft.loop[index - 1], gymEditorDraft.loop[index]] =
            [gymEditorDraft.loop[index], gymEditorDraft.loop[index - 1]];
          renderGymEditorLoop();
        }
        return;
      }

      const down = event.target.closest("[data-gym-editor-down]");
      if (down) {
        const index = Number(down.dataset.gymEditorDown);
        if (index < gymEditorDraft.loop.length - 1) {
          [gymEditorDraft.loop[index + 1], gymEditorDraft.loop[index]] =
            [gymEditorDraft.loop[index], gymEditorDraft.loop[index + 1]];
          renderGymEditorLoop();
        }
        return;
      }

      const del = event.target.closest("[data-gym-editor-delete]");
      if (del) {
        const index = Number(del.dataset.gymEditorDelete);
        gymEditorDraft.loop.splice(index, 1);
        renderGymEditorLoop();
      }
    });

    gymDaysTrack.addEventListener("click", event => {
      const card = event.target.closest("[data-gym-date]");
      if (!card) return;

      selectedGymDate = parseIsoLocal(card.dataset.gymDate);
      renderGymCalendar();
      renderSelectedGymDay();
    });


    const NUTRITION_STORAGE_KEY = "lifeDashboardNutritionV2";

    const nutritionMealSlots = [
      { key: "breakfast", label: "Frühstück" },
      { key: "lunch", label: "Mittagessen" },
      { key: "snack", label: "Snack / Shake" },
      { key: "dinner", label: "Abendessen" }
    ];

    const nutritionToday = new Date();
    nutritionToday.setHours(0,0,0,0);
    let selectedNutritionDate = new Date(nutritionToday);

    function nutritionClone(value) {
      return JSON.parse(JSON.stringify(value));
    }

    function emptyNutritionMeal() {
      return { name: "", ingredients: [], persons: 1 };
    }

    function defaultNutritionCycleStart() {
      const monday = startOfWeek(nutritionToday);
      return makeIsoDate(monday);
    }

    function loadNutritionData() {
      try {
        const savedV2 = JSON.parse(localStorage.getItem(NUTRITION_STORAGE_KEY));
        if (savedV2 && typeof savedV2 === "object") {
          if (!savedV2.days) savedV2.days = {};
          if (!savedV2.checkedShopping) savedV2.checkedShopping = {};
          if (!savedV2.cycleStart) savedV2.cycleStart = defaultNutritionCycleStart();
          if (!savedV2.completedMeals) savedV2.completedMeals = {};
          if (!savedV2.individualDays) savedV2.individualDays = {};
          if (!savedV2.foodLibrary) savedV2.foodLibrary = {};
          if (!savedV2.shoppingMode) savedV2.shoppingMode = "category";
          return savedV2;
        }
